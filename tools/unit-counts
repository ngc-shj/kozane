#!/usr/bin/env python3
"""The `unit` gate's counts from `cargo test` output (M2 plan T12).

Prints UNIT-TESTS (the total) and UNIT-<KEY> per test binary stem (a
crate's lib and bin share their crate's key), so a crate whose tests stop
running fails the manifest even when the total still clears it.

Two test binaries of different crates with one stem (tests/vectors.rs in
both) would share a key and sum silently, so they print
UNIT-KEY-COLLISION-<KEY>; a `Running` path whose owning crate cannot be
read (cargo's build-dir layout, target/<profile>/build/<crate>/...) prints
UNIT-KEY-OWNER-UNKNOWN-<KEY>. No manifest line allows either.

Usage: tools/unit-counts <unit.log>
"""

import collections
import re
import sys

RUNNING = re.compile(r"^\s*Running .*\((\S+)\)\s*$")
DOC = re.compile(r"^\s*Doc-tests (\S+)")
RESULT = re.compile(r"^test result: ok\. (\d+) passed")
OWNER = re.compile(r"/build/([^/]+)/[0-9a-f]+/out/")


def key(name: str) -> str:
    return name.upper().replace("_", "-")


def counts(lines) -> list:
    total, per, crate, clash, unknown = 0, collections.Counter(), {}, set(), set()
    current = None
    for line in lines:
        if (m := RUNNING.match(line)):
            path = m.group(1)
            current = re.sub(r"-[0-9a-f]+$", "", path.rsplit("/", 1)[-1])
            owner = OWNER.search(path)
            if not owner:
                unknown.add(current)
            elif current in crate and crate[current] != owner.group(1):
                clash.add(current)
            else:
                crate[current] = owner.group(1)
        elif (m := DOC.match(line)):
            current = m.group(1)
        elif (m := RESULT.match(line)) and current is not None:
            total += int(m.group(1))
            per[current] += int(m.group(1))
    out = [f"UNIT-TESTS {total}"] + [f"UNIT-{key(k)} {v}" for k, v in sorted(per.items())]
    out += [f"UNIT-KEY-COLLISION-{key(k)} 1" for k in sorted(clash)]
    out += [f"UNIT-KEY-OWNER-UNKNOWN-{key(k)} 1" for k in sorted(unknown)]
    return out


def main(argv) -> int:
    if len(argv) != 2:
        print(__doc__, file=sys.stderr)
        return 2
    with open(argv[1], errors="replace") as f:
        print("\n".join(counts(f)))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
