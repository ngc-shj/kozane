#!/usr/bin/env python3
"""Compares gate counts in a counts directory with the committed manifest.

Usage: check-manifest <manifest.txt> <counts-dir>
       check-manifest --identity
       check-manifest --compare-identity <counts-dir> <counts-dir> ...

Each manifest line is "<KEY> <count>". Every key must appear in the counts
exactly once, with exactly that value, and > 0. Fewer means a gate ran less
than it should; more fails too ("raise the manifest"), since a number left
below the real count is a test that can be deleted without any gate
noticing; a count with no manifest line fails (add it, or, if it is 0, add
tests); and a key reported twice, in one file or two, fails rather than
letting one value hide the other. Exit 1 otherwise.

Image identity (M9 plan C6, T2.4, T3.8): every counts directory also holds
one `IMAGE <digest>` and one `QEMU <build-id>` record, which the gate run
that boots QEMU writes with `--identity`. A missing record fails, and so do
two different values of one; the same value written twice is one record.
`--compare-identity` requires the records of several counts directories
(`make check`'s, `test-kzc`'s, `test-kvm`'s) to be equal, the milestone's
final check that they ran on one image.

The image has no name for itself inside the container, so IMAGE is a digest
of its toolchain's contents: the package database, and the path and bytes of
every file under the image's own trees (/opt and the SDK), and every
symlink, to a file or a directory, by its target. Two hosts agree exactly when they run the same tools, whatever their
filesystems keep of mtimes (M9 deviation D-27); 1.1 GB, about 1.5 s.
"""

import hashlib
import os
import pathlib
import shutil
import subprocess
import sys

IDENTITY_KEYS = ("IMAGE", "QEMU")
IMAGE_TREES = ("/opt",)
PACKAGE_DB = "/var/lib/dpkg/status"


def image_digest() -> str:
    trees = list(IMAGE_TREES)
    if os.environ.get("MICROKIT_SDK"):
        trees.append(os.environ["MICROKIT_SDK"])
    return tree_digest(PACKAGE_DB, trees)


def tree_digest(package_db: str, trees: list) -> str:
    h = hashlib.sha256()
    with open(package_db, "rb") as f:
        h.update(f.read())
    for tree in sorted(set(trees)):
        for top, dirs, files in os.walk(tree):
            dirs.sort()
            # os.walk lists a symlink to a directory under `dirs` and does
            # not enter it, so links are taken from both lists.
            for name in sorted(dirs + files):
                p = os.path.join(top, name)
                if os.path.islink(p):
                    body = "link:" + os.readlink(p)
                elif name in files:
                    with open(p, "rb") as f:
                        body = hashlib.file_digest(f, "sha256").hexdigest()
                else:
                    continue
                h.update(f"{p}\0{body}\n".encode())
    return h.hexdigest()


def qemu_build_id() -> str:
    qemu = shutil.which("qemu-system-aarch64")
    if qemu is None:
        raise SystemExit("check-manifest: qemu-system-aarch64 not found")
    out = subprocess.run(["readelf", "-n", qemu], capture_output=True, text=True, check=True).stdout
    ids = [line.split(":", 1)[1].strip() for line in out.splitlines() if line.strip().startswith("Build ID:")]
    if len(ids) != 1:
        raise SystemExit(f"check-manifest: {qemu} has {len(ids)} build IDs")
    return ids[0]


def identity_text() -> str:
    return f"IMAGE {image_digest()}\nQEMU {qemu_build_id()}\n"


def read_counts(counts_dir: pathlib.Path) -> tuple:
    """(counts, identity, problems): counts and identity records, each key
    mapped to its value(s), and the duplicate-key problems."""
    got, source, ident = {}, {}, {k: set() for k in IDENTITY_KEYS}
    bad = []
    for f in sorted(counts_dir.iterdir()):
        if f.is_file() and f.suffix != ".log":
            for line in f.read_text().splitlines():
                parts = line.split()
                if len(parts) == 2 and parts[0] in IDENTITY_KEYS:
                    ident[parts[0]].add(parts[1])
                elif len(parts) == 2 and parts[1].isdigit():
                    if parts[0] in source:
                        where = f"twice by {f.name}" if source[parts[0]] == f.name else f"by both {source[parts[0]]} and {f.name}"
                        bad.append(f"{parts[0]}: reported {where}")
                    got[parts[0]] = int(parts[1])
                    source.setdefault(parts[0], f.name)
    return got, ident, bad


def identity_problems(ident: dict) -> list:
    bad = []
    for key in IDENTITY_KEYS:
        if not ident[key]:
            bad.append(f"{key} missing (the gate that boots QEMU writes it)")
        elif len(ident[key]) > 1:
            bad.append(f"{key}: two values {sorted(ident[key])}")
    return bad


def check(manifest: pathlib.Path, counts_dir: pathlib.Path) -> list:
    want = {}
    bad = []
    for line in manifest.read_text().splitlines():
        line = line.split("#", 1)[0].strip()
        if line:
            key, n = line.split()
            if key in want:
                bad.append(f"{key}: listed twice in the manifest")
            want[key] = int(n)
    got, ident, dup = read_counts(counts_dir)
    bad += dup + identity_problems(ident)
    for key, n in want.items():
        v = got.get(key)
        if v is None:
            bad.append(f"{key}: missing (gate did not run)")
        elif v == 0 or v < n:
            bad.append(f"{key}: {v} < manifest {n}")
        elif v > n:
            bad.append(f"{key}: {v} > manifest {n} (raise the manifest to {v})")
    for key in sorted(set(got) - set(want)):
        if got[key] == 0:
            bad.append(f"{key}: 0, the gate counted nothing (add tests or drop it from the gate)")
        else:
            bad.append(f"{key}: {got[key]} not in the manifest (add it)")
    return bad


def compare_identity(dirs: list) -> list:
    bad, seen = [], {}
    for d in dirs:
        _, ident, _ = read_counts(d)
        for p in identity_problems(ident):
            bad.append(f"{d}: {p}")
        seen[d] = tuple(sorted(next(iter(ident[k])) if len(ident[k]) == 1 else "?" for k in IDENTITY_KEYS))
    if len(set(seen.values())) > 1:
        bad.append("the counts directories ran on different images: "
                   + "; ".join(f"{d}: {dict(zip(IDENTITY_KEYS, v))}" for d, v in seen.items()))
    return bad


def main() -> int:
    if sys.argv[1:] == ["--identity"]:
        sys.stdout.write(identity_text())
        return 0
    if sys.argv[1:2] == ["--compare-identity"]:
        if len(sys.argv) < 4:
            print("usage: check-manifest --compare-identity <counts-dir> <counts-dir> ...")
            return 2
        bad = compare_identity([pathlib.Path(a) for a in sys.argv[2:]])
    elif len(sys.argv) == 3:
        bad = check(pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2]))
    else:
        print(__doc__.split("\n\n")[1])
        return 2
    for b in bad:
        print(f"check-manifest: {b}")
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
