#!/usr/bin/env python3
"""RustSec advisory gate over Cargo.lock (M3a external review, item 3).

Usage: audit-gate [--db DIR] [--lock FILE] [--ignore FILE]

Runs `cargo audit --no-fetch` against a pinned advisory-db snapshot (baked
into the dev image at /opt/advisory-db; docker/Dockerfile pins its commit
and sha256), so the gate is offline and reproducible. Exit 0 only when:
  - no vulnerability is reported, whatever policy/audit-ignore.toml says;
  - every warning (unmaintained, unsound, yanked, ...) is listed in
    policy/audit-ignore.toml by advisory id and crate;
  - every listed exception still matches a reported warning (a stale one
    must be removed, so the list never hides a later advisory);
  - the database loaded advisories and the lock file listed crates;
  - the report's own settings show nothing filtered: no ignored ids, no
    severity threshold, no target OS/arch filter, and the unmaintained,
    unsound and notice warnings enabled; and its vulnerability count agrees
    with its list.
cargo-audit reads `audit.toml` from $CARGO_HOME, ~/.cargo and the working
directory's `.cargo/`, any of which could ignore an advisory. The binary is
therefore run directly from an empty temporary HOME, CARGO_HOME and
working directory, so no such file is read; the settings check above
catches one that is read anyway.
Prints "AUDIT-ADVISORIES <n>" (advisories in the pinned snapshot) for the
count manifest; a refreshed snapshot changes it on purpose.

Control class: fail-closed over the snapshot it reads. It cannot see an
advisory published after the pinned commit; refreshing the pin is a
manual step (record it in the deviation log), and a fresh check is
`audit-gate --db <a current advisory-db checkout>`.
"""

import argparse
import json
import os
import pathlib
import shutil
import subprocess
import sys
import tempfile
import tomllib

ROOT = pathlib.Path(__file__).resolve().parents[1]
FIELDS = ("id", "crate", "reason", "owner")
REQUIRED_WARNINGS = {"unmaintained", "unsound", "notice"}


def settings_errors(settings) -> list:
    """Anything in the report's settings that would hide an advisory."""
    if not isinstance(settings, dict):
        return ["audit-gate: the report has no settings; refusing"]
    errors = []
    if settings.get("ignore") != []:
        errors.append(f"audit-gate: cargo audit ran with ignored advisories {settings.get('ignore')!r}")
    if settings.get("severity") is not None:
        errors.append(f"audit-gate: cargo audit ran with a severity threshold {settings.get('severity')!r}")
    for k in ("target_arch", "target_os"):
        if settings.get(k) != []:
            errors.append(f"audit-gate: cargo audit ran with a {k} filter {settings.get(k)!r}")
    enabled = settings.get("informational_warnings")
    if not isinstance(enabled, list) or not REQUIRED_WARNINGS <= set(enabled):
        errors.append(f"audit-gate: cargo audit ran without the warnings {sorted(REQUIRED_WARNINGS)} (got {enabled!r})")
    return errors


def load_ignores(path: pathlib.Path) -> dict:
    data = tomllib.loads(path.read_text())
    if set(data) - {"ignore"}:
        raise SystemExit(f"audit-gate: {path}: unknown top-level keys {sorted(set(data) - {'ignore'})}")
    out = {}
    for i, e in enumerate(data.get("ignore", [])):
        if not isinstance(e, dict) or set(e) != set(FIELDS) or not all(isinstance(e[k], str) and e[k] for k in FIELDS):
            raise SystemExit(f"audit-gate: {path}: entry {i} must have exactly the non-empty string keys {', '.join(FIELDS)}")
        if e["id"] in out:
            raise SystemExit(f"audit-gate: {path}: {e['id']} listed twice")
        out[e["id"]] = e
    return out


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--db", default="/opt/advisory-db")
    ap.add_argument("--lock", default=str(ROOT / "Cargo.lock"))
    ap.add_argument("--ignore", default=str(ROOT / "policy/audit-ignore.toml"))
    a = ap.parse_args()
    ignores = load_ignores(pathlib.Path(a.ignore))
    binary = shutil.which("cargo-audit")
    if binary is None:
        print("audit-gate: cargo-audit not found on PATH")
        return 1
    with tempfile.TemporaryDirectory(prefix="audit-gate-") as empty:
        env = {**os.environ, "HOME": empty, "CARGO_HOME": empty}
        r = subprocess.run([binary, "audit", "--no-fetch", "--db", os.path.abspath(a.db),
                            "--file", os.path.abspath(a.lock), "--json"],
                           capture_output=True, text=True, cwd=empty, env=env)
    try:
        report = json.loads(r.stdout)
    except json.JSONDecodeError:
        print(r.stdout + r.stderr)
        print(f"audit-gate: cargo audit produced no report (exit {r.returncode})")
        return 1
    errors = settings_errors(report.get("settings"))
    advisories = report.get("database", {}).get("advisory-count", 0)
    crates = report.get("lockfile", {}).get("dependency-count", 0)
    if not advisories or not crates:
        errors.append(f"audit-gate: examined nothing ({advisories} advisories, {crates} crates)")
    vulns = report.get("vulnerabilities", {})
    listed = vulns.get("list", [])
    if vulns.get("count") != len(listed) or vulns.get("found") != bool(listed):
        errors.append(f"audit-gate: inconsistent report (count {vulns.get('count')!r}, found {vulns.get('found')!r}, "
                      f"{len(listed)} listed)")
    for v in listed:
        errors.append(f"audit-gate: vulnerability {v['advisory']['id']} in {v['package']['name']} "
                      f"{v['package']['version']}: {v['advisory']['title']}")
    seen = set()
    for kind, items in report.get("warnings", {}).items():
        for w in items:
            adv = w.get("advisory") or {}
            wid, crate = adv.get("id", f"{kind}:{w['package']['name']}"), w["package"]["name"]
            e = ignores.get(wid)
            if e is None or e["crate"] != crate:
                errors.append(f"audit-gate: {kind} warning {wid} for {crate} {w['package']['version']} "
                              "is not excepted in policy/audit-ignore.toml")
            seen.add(wid)
    for wid in sorted(set(ignores) - seen):
        errors.append(f"audit-gate: exception {wid} matches no reported warning; remove it")
    if errors:
        print("\n".join(errors))
        return 1
    print(f"audit-gate: {crates} crates, {len(seen)} excepted warnings")
    print(f"AUDIT-ADVISORIES {advisories}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
