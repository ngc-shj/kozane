def edit(tree: pathlib.Path, rel: str, old: str, new: str):
    p = tree / rel
    text = p.read_text()
    if text.count(old) != 1:
        raise SystemExit(f"selftest: injection anchor in {rel} matched {text.count(old)} times: {old!r}")
    p.write_text(text.replace(old, new))


def append(tree: pathlib.Path, rel: str, text: str):
    p = tree / rel
    if not p.exists():
        raise SystemExit(f"selftest: {rel} missing")
    p.write_text(p.read_text() + text)


def two_key_channel(tree: pathlib.Path, caller: str, caller_id: int, callee: str, callee_id: int):
    edit(tree, "system/secureos.system", "</system>",
         f'    <channel>\n        <end pd="{caller}" id="{caller_id}" pp="true" notify="false" />\n'
         f'        <end pd="{callee}" id="{callee_id}" pp="false" />\n    </channel>\n</system>')
    append(tree, "policy/laws.toml",
           f'\n[[channels]]\nbetween = ["{caller}", "{callee}"]\n'
           f'pp = {{ {caller} = true, {callee} = false }}\nnotify = {{ {caller} = false, {callee} = true }}\n')


