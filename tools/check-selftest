    "kani": {"kani", "kani-cache"},
    "bolero": {"bolero", "bolero-wg-wire"},
    "laws": {"laws", "laws-timer-ingress"},
    "test": {"integration", "integration-count", "integration-residue", "integration-cookie"},
    "manifest": {"manifest"},
