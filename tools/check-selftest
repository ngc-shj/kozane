def edit(tree: pathlib.Path, rel: str, old: str, new: str):
    p = tree / rel
    text = p.read_text()
    if text.count(old) != 1:
        raise SystemExit(f"selftest: injection anchor in {rel} matched {text.count(old)} times: {old!r}")
    p.write_text(text.replace(old, new))


def strip_mce_wipes(tree: pathlib.Path):
    """Every local `.zeroize();` in mce460896, both stack scrubs and the
    shim's Zeroizing removed: nothing wipes any McEliece intermediate."""
    removed = 0
    for p in sorted((tree / "crates/mce460896/src").glob("*.rs")):
        text = p.read_text()
        new = re.sub(r"(?m)^[ \t]*[A-Za-z_][A-Za-z0-9_.]*\.zeroize\(\);\n", "", text)
        removed += text.count(".zeroize();") - new.count(".zeroize();")
        p.write_text(new)
    if removed < 40:
        raise SystemExit(f"selftest: only {removed} wipes found in mce460896")
    edit(tree, "crates/mce460896/src/lib.rs", "    decaps_core(sk, ct, ss_out);\n    scrub_stack();\n",
         "    decaps_core(sk, ct, ss_out);\n")
    edit(tree, "crates/mce460896/src/lib.rs", "    let accept = encaps_attempt_core(pk, rand, ct_out, ss_out);\n    scrub_stack_encaps();\n",
         "    let accept = encaps_attempt_core(pk, rand, ct_out, ss_out);\n")
    edit(tree, "crates/mce460896/src/lib.rs", "    let mut rand = Zeroizing::new([0u8; ENCAPS_RAND_LEN]);\n",
         "    let mut rand = [0u8; ENCAPS_RAND_LEN];\n")


