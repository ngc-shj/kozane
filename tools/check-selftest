def manifest_count(key: str) -> int:
    """`key`'s count in tests/manifest.txt, so a needle derived from it
    follows the manifest instead of going stale when tests are added."""
    for line in (ROOT / "tests/manifest.txt").read_text().splitlines():
        if line.split()[:1] == [key]:
            return int(line.split()[1])
    raise SystemExit(f"selftest: {key} not in tests/manifest.txt")


def doctest_line(rel: str, fence: str) -> int:
    """The line of the one doctest opened by `//! {fence}` in `rel`, as
    rustdoc names it, so a needle naming the doctest follows the source."""
    lines = (ROOT / rel).read_text().splitlines()
    hits = [i + 1 for i, line in enumerate(lines) if line.strip() == f"//! {fence}"]
    if len(hits) != 1:
        raise SystemExit(f"selftest: {fence!r} opens {len(hits)} doctests in {rel}")
    return hits[0]


