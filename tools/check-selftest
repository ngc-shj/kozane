# One case's make run, bounded: a mutant can loop for ever (the first
# mce-fresh-draw did, in mksecrets' tests). The whole process group is
# killed, with SIGKILL since mksecrets blocks SIGTERM while it writes.
CASE_TIMEOUT_S = 4 * 3600
# A timed-out case fails whatever its partial output held (a needle in it
# does not make an unfinished gate a red-proof).
TIMED_OUT = 124


def run_make(tree: pathlib.Path, *targets: str) -> subprocess.CompletedProcess:
    proc = subprocess.Popen(["make", "-C", str(tree), *targets], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            text=True, env=MAKE_ENV, start_new_session=True)
    try:
        stdout, stderr = proc.communicate(timeout=CASE_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        os.killpg(proc.pid, signal.SIGKILL)
        stdout, stderr = proc.communicate()
        return subprocess.CompletedProcess(proc.args, TIMED_OUT, stdout,
                                           stderr + f"\nselftest: timed out after {CASE_TIMEOUT_S} s\n")
    return subprocess.CompletedProcess(proc.args, proc.returncode, stdout, stderr)


def append(tree: pathlib.Path, rel: str, text: str):
    p = tree / rel
    if not p.exists():
        raise SystemExit(f"selftest: {rel} missing")
    p.write_text(p.read_text() + text)


def two_key_channel(tree: pathlib.Path, caller: str, caller_id: int, callee: str, callee_id: int):
    edit(tree, "system/kozane.system", "</system>",
         f'    <channel>\n        <end pd="{caller}" id="{caller_id}" pp="true" notify="false" />\n'
         f'        <end pd="{callee}" id="{callee_id}" pp="false" />\n    </channel>\n</system>')
    append(tree, "policy/laws.toml",
           f'\n[[channels]]\nbetween = ["{caller}", "{callee}"]\n'
           f'pp = {{ {caller} = true, {callee} = false }}\nnotify = {{ {caller} = false, {callee} = true }}\n')


def share_key_with_tls(tree: pathlib.Path):
    """`tls` back on `key`'s endpoint (M6 slice 2's shape) and `tlskey`
    removed with its region, its PPCs to `tpm` and `rng` and their policy entries, so
    the system is otherwise lawful."""
    edit(tree, "system/kozane.system", '<end pd="tlskey" id="1" pp="false" />', '<end pd="key" id="2" pp="false" />')
    edit(tree, "system/kozane.system",
         '    <channel>\n        <end pd="tlskey" id="3" pp="true" notify="false" />\n'
         '        <end pd="tpm" id="3" pp="false" notify="false" />\n    </channel>\n', "")
    text = (tree / "system/kozane.system").read_text()
    pd = re.search(r'\n\n *<!-- M6 plan C12: the TLS signing oracle\..*?</protection_domain>\n', text, re.S)
    mr = re.search(r'    <!-- tlskey\'s TLS signing key .*?prefill_path="tls-secrets-placeholder.bin" />\n', text, re.S)
    if not pd or not mr:
        raise SystemExit("selftest: tlskey's pd or region not found in the system file")
    (tree / "system/kozane.system").write_text(text.replace(pd.group(0), "\n").replace(mr.group(0), ""))
    edit(tree, "policy/laws.toml", '[[channels]]\nbetween = ["tls", "tlskey"]\npp = { tls = true, tlskey = false }\n'
         'notify = { tls = false, tlskey = true }\n',
         '[[channels]]\nbetween = ["tls", "key"]\npp = { tls = true, key = false }\nnotify = { tls = false, key = true }\n')
    edit(tree, "policy/laws.toml", '\n[[channels]]\nbetween = ["tlskey", "tpm"]\npp = { tlskey = true, tpm = false }\n'
         'notify = { tlskey = false, tpm = false }\n', "")
    # M7 plan C6: and its seed oracle channel.
    edit(tree, "system/kozane.system",
         '    <channel>\n        <end pd="tlskey" id="4" pp="true" notify="false" />\n'
         '        <end pd="rng" id="7" pp="false" />\n    </channel>\n', "")
    edit(tree, "policy/laws.toml", '\n[[channels]]\nbetween = ["tlskey", "rng"]\npp = { tlskey = true, rng = false }\n'
         'notify = { tlskey = false }\n', "")
    edit(tree, "policy/laws.toml", '\n[pds.tlskey]\nrole = "key"\n', "")
    edit(tree, "policy/laws.toml", '\n[mrs.tls_secrets]\nkind = "secrets"\nowner = "tlskey"\n', "")


