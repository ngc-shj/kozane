def copy_repo(dst: pathlib.Path):
    for item in ROOT.iterdir():
        if item.name in SKIP:
            continue
        if item.is_dir():
            shutil.copytree(item, dst / item.name, ignore=shutil.ignore_patterns(*SKIP))
        else:
            shutil.copy2(item, dst / item.name)


EXPECT_SUCCESS = {"kani-cache"}
ABSENT = {"kani-cache": "cached pass"}


def rule_prerequisites(text: str) -> dict:
    """target -> plain-word prerequisites (normal and order-only) from the
    Makefile's rule heads. Variable references are skipped."""
    deps = {}
    for line in text.splitlines():
        m = re.match(r"^([A-Za-z0-9_.-]+)\s*:(?!=)\s*([^=#;]*)", line)
        if not m or line.startswith("\t"):
            continue
        words = [w for w in m.group(2).replace("|", " ").split() if not w.startswith("$")]
        deps.setdefault(m.group(1), []).extend(words)
    return deps


def closure(gates: list, deps: dict) -> list:
    """The gates plus everything they depend on, transitively."""
    seen, todo = [], list(gates)
    while todo:
        t = todo.pop()
        if t not in seen:
            seen.append(t)
            todo += deps.get(t, [])
    return seen


def run_propagation(gates: list) -> bool:
    """For each gate of the `check` rule, replace the recipes of every gate
    and its prerequisites with no-ops except that gate, which fails with a
    marker, and run the real `make check`. This proves the check rule passes
    a gate's failure through masks applied around recipes: an error-ignore
    prefix, .IGNORE or MAKEFLAGS -i, including ones built from variables or
    conditioned on MAKECMDGOALS, MAKELEVEL or the state of build/counts: the
    counts and logs of the last real run are copied in, and clean-counts
    keeps its real recipe (unless it is the gate under test), so the file
    state the gates see matches a real `make check`. It does not run real
    gate recipes in the `check` context, so a mask written inside a recipe
    and keyed on that context is not caught (accepted, code review Round 7
    S2).
    """
    ok = True
    for target in gates:
        with tempfile.TemporaryDirectory(prefix=f"selftest-propagation-{target}-") as d:
            tree = pathlib.Path(d)
            copy_repo(tree)
            if not (ROOT / "build/counts").is_dir():
                print("FAIL check-propagation: build/counts missing; run `make check` first")
                return False
            shutil.copytree(ROOT / "build/counts", tree / "build/counts")
            # make accumulates prerequisites across rules, so a gate's own
            # prerequisites (e.g. test: image) still run unless they are
            # replaced too; replace the whole closure.
            makefile = (tree / "Makefile").read_text()
            overrides = "\n# selftest: recipes replaced (make warns about overriding)\n"
            for g in closure(gates, rule_prerequisites(makefile)):
                # clean-counts is cheap and its effect on file state matters.
                if g == "clean-counts" and g != target:
                    continue
                body = f"@echo selftest-gate-{g}; exit 1" if g == target else "@true"
                overrides += f"{g}:\n\t{body}\n"
            (tree / "Makefile").write_text(makefile + overrides)
            out = subprocess.run(["make", "-C", str(tree), "check"], capture_output=True, text=True, env=MAKE_ENV)
            text = out.stdout + out.stderr
        needle = f"selftest-gate-{target}"
        # make's own failure line names the rule that failed, so the
        # non-zero exit is attributable to the target gate.
        failed_rule = re.search(rf"\[[^\]]*: {re.escape(target)}\] Error 1", text)
        this_ok = out.returncode != 0 and needle in text and failed_rule is not None
        ok &= this_ok
        print(f"{'ok  ' if this_ok else 'FAIL'} check-propagation[{target}]: exit={out.returncode} needle={needle!r}")
        if not this_ok:
            print(text[-2000:])
    return ok


def run_case(name: str) -> bool:
    if name == "check-propagation":
        return run_propagation(check_gates())
    targets, inject, needle = CASES[name]
    with tempfile.TemporaryDirectory(prefix=f"selftest-{name}-") as d:
        tree = pathlib.Path(d)
        copy_repo(tree)
        # Populate counts the manifest needs from the real tree, except the
        # layer under test, so only the injected layer can fail.
        if "manifest" in targets:
            shutil.copytree(ROOT / "build/counts", tree / "build/counts")
        # Start from the real proof cache, so an injection is detected only
        # if it changes the cache key.
        if "kani" in targets and (ROOT / "build/kani-cache").is_dir():
            shutil.copytree(ROOT / "build/kani-cache", tree / "build/kani-cache")
        if name == "kani-cache":
            # Allow side first: the uninjected copy must hit the cache, or
            # the injected run below would prove nothing about the key.
            pre = subprocess.run(["make", "-C", str(tree), *targets], capture_output=True, text=True, env=MAKE_ENV)
            pre_path = tree / "build/counts/kani.log"
            pre_log = pre_path.read_text(errors="replace") if pre_path.exists() else ""
            if pre.returncode != 0 or "cached pass" not in pre_log:
                print(f"FAIL {name}: uninjected copy did not hit the proof cache")
                print((pre.stdout + pre.stderr)[-2000:])
                return False
        inject(tree)
        out = subprocess.run(["make", "-C", str(tree), *targets], capture_output=True, text=True, env=MAKE_ENV)
        text = out.stdout + out.stderr
        # Gates write their tool output to build/counts/*.log.
        for log in sorted((tree / "build/counts").glob("*.log")):
            text += log.read_text(errors="replace")
    if name in EXPECT_SUCCESS:
        ok = out.returncode == 0 and needle in text and ABSENT[name] not in text
    else:
        ok = out.returncode != 0 and needle in text
    print(f"{'ok  ' if ok else 'FAIL'} {name}: exit={out.returncode} needle={needle!r} found={needle in text}")
    if not ok:
        print(text[-3000:])
    return ok


def main() -> int:
    try:
        gates = check_gates()
    except GateParseError as e:
        print(f"selftest: {e}")
        return 1
    unknown = [g for g in gates if g not in CASES_FOR_GATE]
    expected = set().union(*(CASES_FOR_GATE[g] for g in gates if g in CASES_FOR_GATE))
    if unknown or set(CASES) != expected:
        print(f"selftest: gates without a case {unknown}; case mismatch {sorted(set(CASES) ^ expected)}")
        return 1
    # Stale counts are only harmless if `check` clears them before any gate.
    if gates[:1] != ["clean-counts"]:
        print(f"selftest: `check` must run clean-counts first, runs {gates}")
        return 1
    names = sys.argv[1:] or list(CASES)
    results = [run_case(n) for n in names]
    print(f"SELFTEST-LAYERS {sum(results)}")
    return 0 if all(results) else 1


if __name__ == "__main__":
    sys.exit(main())
