def copy_repo(dst: pathlib.Path):
    for item in ROOT.iterdir():
        if item.name in SKIP:
            continue
        if item.is_dir():
            shutil.copytree(item, dst / item.name, ignore=shutil.ignore_patterns(*SKIP))
        else:
            shutil.copy2(item, dst / item.name)


# The injected copy lives at one fixed path, reused across cases, so its
# cargo target dirs stay warm and a case rebuilds only what its injection
# touched. Each case first puts the sources back exactly as the real tree's
# (`sync_tree`: by content, so a file a previous case mutated is rewritten
# with a fresh mtime and cargo rebuilds it). Everything else under build/
# (counts, caches, records, images) is removed.
# Outside the checkout, so cargo does not merge the checkout's
# .cargo/config.toml into the copy's as a parent directory's.
WORK = pathlib.Path(tempfile.gettempdir()) / "kozane-selftest"
KEEP_BUILD = re.compile(r"^target")


def sync_tree(src: pathlib.Path, dst: pathlib.Path):
    """`dst` made equal to `src`, SKIP names (at any depth) excluded on both
    sides and left alone in `dst`. A file is rewritten only if its bytes or
    mode differ, so unchanged files keep their mtime."""
    dst.mkdir(exist_ok=True)
    wanted = {e.name for e in src.iterdir() if e.name not in SKIP}
    for e in dst.iterdir():
        if e.name in SKIP or e.name in wanted:
            continue
        shutil.rmtree(e) if e.is_dir() and not e.is_symlink() else e.unlink()
    for name in sorted(wanted):
        s, d = src / name, dst / name
        if s.is_symlink():
            if not d.is_symlink() or os.readlink(d) != os.readlink(s):
                if d.is_dir() and not d.is_symlink():
                    shutil.rmtree(d)
                elif d.exists() or d.is_symlink():
                    d.unlink()
                os.symlink(os.readlink(s), d)
        elif s.is_dir():
            if d.exists() and (d.is_symlink() or not d.is_dir()):
                d.unlink()
            sync_tree(s, d)
        else:
            if d.is_dir() and not d.is_symlink():
                shutil.rmtree(d)
            if d.is_symlink() or not d.exists() or d.stat().st_size != s.stat().st_size \
                    or d.read_bytes() != s.read_bytes():
                if d.is_symlink():
                    d.unlink()
                shutil.copyfile(s, d)
            if (d.stat().st_mode & 0o7777) != (s.stat().st_mode & 0o7777):
                shutil.copymode(s, d)


def clear_crashes(tree: pathlib.Path):
    """SKIP names survive sync_tree at any depth; bolero's crash inputs must
    not, or an old crash could make the bolero case pass."""
    for top, dirs, _ in os.walk(tree):
        if "crashes" in dirs:
            shutil.rmtree(pathlib.Path(top) / "crashes")
        dirs[:] = [d for d in dirs if d not in SKIP]


def warm_tree() -> pathlib.Path:
    tree = WORK / "tree"
    tree.mkdir(parents=True, exist_ok=True)
    sync_tree(ROOT, tree)
    clear_crashes(tree)
    build = tree / "build"
    for item in build.iterdir() if build.is_dir() else []:
        if item.is_dir() and item.name == "ct":
            for sub in item.iterdir():
                if not (sub.is_dir() and KEEP_BUILD.match(sub.name)):
                    shutil.rmtree(sub) if sub.is_dir() else sub.unlink()
        elif not (item.is_dir() and KEEP_BUILD.match(item.name)):
            shutil.rmtree(item) if item.is_dir() and not item.is_symlink() else item.unlink()
    return tree


EXPECT_SUCCESS = {"kani-cache", "verus-cache"}
ABSENT = {"kani-cache": "cached pass", "verus-cache": "cached pass"}


def rule_prerequisites(text: str) -> dict:
    """target -> plain-word prerequisites (normal and order-only) from the
    Makefile's rule heads. Variable references are skipped."""
    deps = {}
    # A backslash-newline continues the line, in a rule head as anywhere.
    for line in text.replace("\\\n", " ").splitlines():
        m = re.match(r"^([A-Za-z0-9_.-]+)\s*:(?!=)\s*([^=#;]*)", line)
        if not m or line.startswith("\t"):
            continue
        words = [w for w in m.group(2).replace("|", " ").split() if not w.startswith("$")]
        deps.setdefault(m.group(1), []).extend(words)
    return deps


def closure(gates: list, deps: dict) -> list:
    """The gates plus everything they depend on, transitively."""
    seen, todo = [], list(gates)
    while todo:
        t = todo.pop()
        if t not in seen:
            seen.append(t)
            todo += deps.get(t, [])
    return seen


def run_propagation(gates: list) -> bool:
    """For each gate of the `check` rule, replace the recipes of every gate
    and its prerequisites with no-ops except that gate, which fails with a
    marker, and run the real `make check`. This proves the check rule passes
    a gate's failure through masks applied around recipes: an error-ignore
    prefix, .IGNORE or MAKEFLAGS -i, including ones built from variables or
    conditioned on MAKECMDGOALS, MAKELEVEL or the state of build/counts: the
    counts and logs of the last real run are copied in, and clean-counts
    keeps its real recipe (unless it is the gate under test), so the file
    state the gates see matches a real `make check`. It does not run real
    gate recipes in the `check` context, so a mask written inside a recipe
    and keyed on that context is not caught (accepted, code review Round 7
    S2).
    """
    ok = True
    for target in gates:
        with tempfile.TemporaryDirectory(prefix=f"selftest-propagation-{target}-") as d:
            tree = pathlib.Path(d)
            copy_repo(tree)
            if not (ROOT / "build/counts").is_dir():
                print("FAIL check-propagation: build/counts missing; run `make check` first")
                return False
            shutil.copytree(ROOT / "build/counts", tree / "build/counts")
            # make accumulates prerequisites across rules, so a gate's own
            # prerequisites (e.g. test: image) still run unless they are
            # replaced too; replace the whole closure.
            makefile = (tree / "Makefile").read_text()
            overrides = "\n# selftest: recipes replaced (make warns about overriding)\n"
            for g in closure(gates, rule_prerequisites(makefile)):
                # clean-counts is cheap and its effect on file state matters.
                if g == "clean-counts" and g != target:
                    continue
                body = f"@echo selftest-gate-{g}; exit 1" if g == target else "@true"
                overrides += f"{g}:\n\t{body}\n"
            (tree / "Makefile").write_text(makefile + overrides)
            out = run_make(tree, "check")
            text = out.stdout + out.stderr
        needle = f"selftest-gate-{target}"
        # make's own failure line names the rule that failed, so the
        # non-zero exit is attributable to the target gate.
        failed_rule = re.search(rf"\[[^\]]*: {re.escape(target)}\] Error 1", text)
        this_ok = out.returncode != 0 and needle in text and failed_rule is not None
        ok &= this_ok
        print(f"{'ok  ' if this_ok else 'FAIL'} check-propagation[{target}]: exit={out.returncode} needle={needle!r}")
        if not this_ok:
            print(text[-2000:])
    return ok


def run_case(name: str) -> bool:
    if name == "check-propagation":
        return run_propagation(check_gates())
    targets, inject, needle = CASES[name]
    tree = warm_tree()
    # Populate counts the manifest needs from the real tree, except the
    # layer under test, so only the injected layer can fail.
    if "manifest" in targets:
        shutil.copytree(ROOT / "build/counts", tree / "build/counts")
    # Start from the real proof cache, so an injection is detected only
    # if it changes the cache key.
    for gate in ("kani", "verus"):
        if gate in targets and (ROOT / f"build/{gate}-cache").is_dir():
            shutil.copytree(ROOT / f"build/{gate}-cache", tree / f"build/{gate}-cache")
    if name in ("kani-cache", "verus-cache"):
        # Allow side first: the uninjected copy must hit the cache, or
        # the injected run below would prove nothing about the key.
        pre = run_make(tree, *targets)
        pre_path = tree / f"build/counts/{name.split('-')[0]}.log"
        pre_log = pre_path.read_text(errors="replace") if pre_path.exists() else ""
        if pre.returncode != 0 or "cached pass" not in pre_log:
            print(f"FAIL {name}: uninjected copy did not hit the proof cache")
            print((pre.stdout + pre.stderr)[-2000:])
            return False
    inject(tree)
    out = run_make(tree, *targets)
    text = out.stdout + out.stderr
    # Gates write their tool output to build/counts/*.log.
    for log in sorted((tree / "build/counts").glob("*.log")):
        text += log.read_text(errors="replace")
    # A needle is a string, a tuple of alternatives, or a compiled pattern
    # (for a report whose varying part, an address, sits mid-line).
    if isinstance(needle, re.Pattern):
        found = needle.search(text) is not None
    else:
        found = any(n in text for n in (needle if isinstance(needle, tuple) else (needle,)))
    if out.returncode == TIMED_OUT:
        ok = False
    elif name in EXPECT_SUCCESS:
        ok = out.returncode == 0 and found and ABSENT[name] not in text
    else:
        ok = out.returncode != 0 and found
    print(f"{'ok  ' if ok else 'FAIL'} {name}: exit={out.returncode} needle={needle!r} found={found}")
    if not ok:
        # The gate logs follow make's own output in `text`, so its tail can be
        # all unit-test noise (as integration-count's first long-run failure
        # was). Show every failure line, then make's own tail.
        for line in re.findall(r"(?m)^FAIL \[[^\n]*", text):
            print(line[:300])
        print((out.stdout + out.stderr)[-2000:])
    return ok


def run_cases(names: list) -> list:
    """Each case's result, in order. A case whose injection cannot apply
    (edit()'s anchor miss and the other helpers' SystemExit) fails alone
    instead of ending the run. "SELFTEST-CASE <name> ok|FAIL" marks each
    for tools/selftest-split's merge."""
    results = []
    for name in names:
        try:
            ok = run_case(name)
        except SystemExit as e:
            print(f"FAIL {name}: {e}")
            ok = False
        print(f"SELFTEST-CASE {name} {'ok' if ok else 'FAIL'}", flush=True)
        results.append(ok)
    return results


def dry_case(name: str) -> bool:
    """The injection alone, on a freshly synced copy."""
    if name == "check-propagation":
        return True
    tree = warm_tree()
    try:
        CASES[name][1](tree)
    except SystemExit as e:
        print(f"FAIL {name}: {e}")
        return False
    return True


def needs_counts(name: str) -> bool:
    """The case copies in the last real run's build/counts."""
    return name == "check-propagation" or "manifest" in CASES[name][0]


def main() -> int:
    dry = sys.argv[1:2] == ["--dry"]
    args = sys.argv[2:] if dry else sys.argv[1:]
    try:
        gates = check_gates()
    except GateParseError as e:
        print(f"selftest: {e}")
        return 1
    unknown = [g for g in gates if g not in CASES_FOR_GATE]
    expected = set().union(*(CASES_FOR_GATE[g] for g in gates if g in CASES_FOR_GATE))
    if unknown or set(CASES) != expected:
        print(f"selftest: gates without a case {unknown}; case mismatch {sorted(set(CASES) ^ expected)}")
        return 1
    # Stale counts are only harmless if `check` clears them before any gate.
    if gates[:1] != ["clean-counts"]:
        print(f"selftest: `check` must run clean-counts first, runs {gates}")
        return 1
    names = args or list(CASES)
    unknown = [n for n in names if n not in CASES]
    if unknown:
        print(f"selftest: no such case {unknown}")
        return 1
    if not dry and any(map(needs_counts, names)) and not (ROOT / "build/counts").is_dir():
        print("selftest: build/counts missing; run `make check` first, or unpack the make check host's "
              "(tools/selftest-split pack / run --inputs)")
        return 1
    # One selftest at a time: the cases share the warm tree.
    WORK.mkdir(parents=True, exist_ok=True)
    lock = open(WORK / ".lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print(f"selftest: another selftest holds {WORK}/.lock")
        return 1
    if dry:
        results = [dry_case(n) for n in names]
        print(f"SELFTEST-DRY {sum(results)} of {len(results)}")
        return 0 if all(results) else 1
    results = run_cases(names)
    print(f"SELFTEST-LAYERS {sum(results)}")
    return 0 if all(results) else 1


if __name__ == "__main__":
    sys.exit(main())
