<?xml version="1.0" encoding="UTF-8"?>
<system>
    <memory_region name="device_mr" size="0x1000" phys_addr="0x9000000" />
    <memory_region name="shared_mr" size="0x1000" />
    <memory_region name="secrets_mr" size="0x1000" />

    <protection_domain name="driver" priority="1" budget="1_000" period="10_000">
        <program_image path="driver.elf" />
        <map mr="device_mr" vaddr="0x1_000_000" perms="rw" />
        <map mr="shared_mr" vaddr="0x2_000_000" perms="rw" />
    </protection_domain>

    <protection_domain name="ingress" priority="1" budget="1_000" period="10_000">
        <program_image path="ingress.elf" />
        <map mr="shared_mr" vaddr="0x2_000_000" perms="rw" />
    </protection_domain>

    <protection_domain name="key" priority="1" passive="true" stack_size="0x2000">
        <program_image path="key.elf" />
        <map mr="secrets_mr" vaddr="0xff_ffff_a000" perms="r" />
    </protection_domain>
</system>
