<?xml version="1.0" encoding="UTF-8"?>
<system>
    <memory_region name="device_mr" size="0x1000" phys_addr="0x9000000" />
    <memory_region name="secrets_mr" size="0x1000" />

    <protection_domain name="driver" priority="3" budget="1_000" period="10_000">
        <program_image path="driver.elf" />
        <map mr="device_mr" vaddr="0x1_000_000" perms="rw" />
    </protection_domain>

    <protection_domain name="mid" priority="2" budget="1_000" period="10_000">
        <program_image path="mid.elf" />
    </protection_domain>

    <protection_domain name="far" priority="1" budget="1_000" period="10_000">
        <program_image path="far.elf" />
        <map mr="secrets_mr" vaddr="0x2_000_000" perms="r" />
    </protection_domain>

    <channel>
        <end pd="driver" id="0" />
        <end pd="mid" id="0" />
    </channel>
    <channel>
        <end pd="mid" id="1" />
        <end pd="far" id="0" />
    </channel>
</system>
