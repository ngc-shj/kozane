<?xml version="1.0" encoding="UTF-8"?>
<system>
    <memory_region name="device_mr" size="0x1000" phys_addr="0x9000000" />
    <memory_region name="secrets_mr" size="0x1000" />

    <protection_domain name="driver" priority="2" budget="1_000" period="10_000">
        <program_image path="driver.elf" />
        <map mr="device_mr" vaddr="0x1_000_000" perms="rw" />
    </protection_domain>

    <protection_domain name="key" priority="1" passive="true" budget="1_000" period="10_000">
        <program_image path="key.elf" />
        <map mr="secrets_mr" vaddr="0x2_000_000" perms="rw" />
    </protection_domain>

    <channel>
        <end pd="driver" id="0" pp="true" notify="false" />
        <end pd="key" id="0" pp="false" />
    </channel>
</system>
