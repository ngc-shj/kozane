<?xml version="1.0" encoding="UTF-8"?>
<system>
    <memory_region name="secrets_mr" size="0x1000" />
    <protection_domain name="untrusted" priority="1">
        <program_image path="untrusted.elf" />
    </protection_domain>
    <protection_domain name="key" priority="2" passive="true">
        <program_image path="key.elf" />
        <map mr="secrets_mr" vaddr="0x1_000_000" perms="r" />
    </protection_domain>
</system>
