<?xml version="1.0" encoding="UTF-8"?>
<system>
    <memory_region name="key_secrets" size="0x1000" prefill_path="key-secrets.bin" />
    <memory_region name="pq_secrets" size="0x1000" prefill_path="pq-secrets.bin" />

    <protection_domain name="caller_a" priority="1">
        <program_image path="caller_a.elf" />
    </protection_domain>

    <protection_domain name="caller_b" priority="1">
        <program_image path="caller_b.elf" />
    </protection_domain>

    <protection_domain name="key" priority="2" passive="true">
        <program_image path="key.elf" />
        <map mr="key_secrets" vaddr="0x2_000_000" perms="r" />
    </protection_domain>

    <protection_domain name="pqkey" priority="2" passive="true">
        <program_image path="pqkey.elf" />
        <map mr="pq_secrets" vaddr="0x2_000_000" perms="r" />
    </protection_domain>

    <channel>
        <end pd="caller_a" id="0" pp="true" notify="false" />
        <end pd="key" id="0" pp="false" />
    </channel>

    <channel>
        <end pd="caller_b" id="0" pp="true" notify="false" />
        <end pd="pqkey" id="0" pp="false" />
    </channel>
</system>
