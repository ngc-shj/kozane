<?xml version="1.0" encoding="UTF-8"?>
<system>
    <memory_region name="tis" size="0x1000" phys_addr="0xc000000" />
    <memory_region name="secrets" size="0x1000" />
    <memory_region name="nic" size="0x1000" phys_addr="0xa003000" />
    <protection_domain name="nic" priority="1" budget="1_000" period="10_000">
        <program_image path="nic.elf" />
        <map mr="nic" vaddr="0x2000000" perms="rw" cached="false" />
    </protection_domain>
    <protection_domain name="key" priority="2" passive="true">
        <program_image path="key.elf" />
        <map mr="secrets" vaddr="0x2000000" perms="r" />
    </protection_domain>
    <protection_domain name="tpm" priority="3" passive="true">
        <program_image path="tpm.elf" />
        <map mr="tis" vaddr="0x2000000" perms="rw" cached="false" />
    </protection_domain>
    <channel>
        <end pd="nic" id="1" pp="true" notify="true" />
        <end pd="key" id="1" pp="false" notify="true" />
    </channel>
    <channel>
        <end pd="key" id="3" pp="true" notify="false" />
        <end pd="tpm" id="1" pp="false" notify="false" />
    </channel>
</system>
