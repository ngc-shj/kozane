<?xml version="1.0" encoding="UTF-8"?>
<system>
    <memory_region name="shared_mr" size="0x1000" />
    <protection_domain name="a" priority="1">
        <program_image path="a.elf" />
        <map mr="shared_mr" vaddr="0x1_000_000" perms="rwx" />
    </protection_domain>
    <protection_domain name="b" priority="1">
        <program_image path="b.elf" />
        <map mr="shared_mr" vaddr="0x1_000_000" perms="rw" />
    </protection_domain>
</system>
