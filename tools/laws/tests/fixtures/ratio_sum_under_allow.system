<?xml version="1.0" encoding="UTF-8"?>
<system>
    <memory_region name="device_mr_a" size="0x1000" phys_addr="0x9000000" />
    <memory_region name="device_mr_b" size="0x1000" phys_addr="0x9002000" />
    <protection_domain name="driver_a" priority="1" budget="400" period="1_000">
        <program_image path="driver_a.elf" />
        <map mr="device_mr_a" vaddr="0x1_000_000" perms="rw" />
    </protection_domain>
    <protection_domain name="driver_b" priority="1" budget="400" period="1_000">
        <program_image path="driver_b.elf" />
