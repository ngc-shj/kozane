<?xml version="1.0" encoding="UTF-8"?>
<system>
    <memory_region name="mr1" size="0x1000" bogus="x" />
    <protection_domain name="a" priority="1">
        <program_image path="a.elf" />
        <map mr="mr1" vaddr="0x1_000_000" perms="rw" />
    </protection_domain>
    <protection_domain name="b" priority="1">
        <program_image path="b.elf" />
        <map mr="mr1" vaddr="0x1_000_000" perms="rw" />
    </protection_domain>
    <channel>
        <end pd="a" id="0" />
        <end pd="b" id="0" />
    </channel>
</system>
