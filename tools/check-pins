    args = ap.parse_args()
    root = pathlib.Path(args.root)
    pending = set() if args.enforce_pending else PENDING
    out: list = []
    docker = (root / "docker/Dockerfile").read_text()
    check_dockerfile(docker, out)
    for p in sorted(root.glob("**/Cargo.toml")):
        if any(part in ("target", "build") for part in p.parts):
            continue
        check_cargo(p, str(p.relative_to(root)), out)
    check_toolchain(docker, (root / "rust-toolchain.toml").read_text(), out)
