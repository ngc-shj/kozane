def integration_names(text: str) -> set:
    """What KOZANE_IT_BOOTS selects (each boot, the C13 cases, the groups)
    and every literal `PASS [<name>]` run.py prints."""
    names = set(re.findall(r'^\s*\("([^"\n]+)", (?:single\(|lambda\b)', text, re.M))
    names |= {f"policy {n}" for n in re.findall(r'\bcase\("([^"\n]+)", \d+, ', text)}
    names |= set(re.findall(r'\("(policy [^"\n]+)", \w+\)', text))
    names |= set(re.findall(r'"([\w-]+)": \{name for name, _ in cases\b', text))
    names |= set(re.findall(r'PASS \[([^\]{}"\n]+)\]', text))
    return names


def selftest_names(text: str) -> set:
    """CASES' literal keys, and every case CASES_FOR_GATE lists (it also
    names the ones CASES builds in a comprehension)."""
    names = set(re.findall(r'^    "([a-z0-9][a-z0-9-]*)": \(', text, re.M))
    gates = re.search(r"^CASES_FOR_GATE = \{\n(.*?)^\}", text, re.M | re.S)
    names |= set(re.findall(r'"([a-z0-9][a-z0-9-]*)"(?!:)', gates.group(1))) if gates else set()
    return names


def test_column_spans(text: str):
    """(line, span) for every backticked span in a table's Test column."""
    column = None
    for n, line in enumerate(text.splitlines(), 1):
        if not line.startswith("|"):
            column = None
            continue
        cells = [c.strip() for c in re.split(r"(?<!\\)\|", line)[1:-1]]
        if column is None:
            column = next((i for i, c in enumerate(cells) if c in ("Test", "Tests")), -1)
            continue
        if 0 <= column < len(cells):
            for span in re.findall(r"`([^`]+)`", cells[column]):
                yield n, span


