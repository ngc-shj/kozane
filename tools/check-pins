#!/usr/bin/env python3
"""Positive pin rules for the dev environment and gates (plan C1, C2).

Usage: check-pins [--root DIR] [--enforce-pending]
Exit 0 when every rule holds; 1 with one line per violation; prints
"CHECK-PINS-RULES <n>" (enforced rules) for the count manifest.

Rules:
  P1 every curl/wget download in docker/Dockerfile is followed, within the
     same RUN, by `sha256sum -c`
  P2 no download is piped into a shell
  P3 every git dependency in a Cargo.toml has rev = "<40 hex>" and no
     branch/tag
  P4 docker/Dockerfile PD_TOOLCHAIN equals the channel in rust-toolchain.toml
  P5 Makefile: SHELL is bash with -euo pipefail; no .IGNORE, no
     .RECIPEPREFIX, no -i/-k in MAKEFLAGS, no '-' recipe prefix (incl. after
     @/+, and on inline `target: ; -cmd` recipes), no `|| true`, `|| :`,
     `|| exit 0`, `; true`, `set +e`
  P6 policy/waivers.toml parses (tools/waivers.py), and while Cargo.lock
     locks classic-mceliece-rust (any version) it lists SC23 with status "open"
     (M3 plan, Packaging)
  P7 no `(?i)psk_?mix` in crates/ (*.rs, Cargo.toml): the static PSK path
     is removed (M3 plan L8, F21)
  P8 no `getrandom|thread_rng|OsRng` in crates/ (*.rs, Cargo.toml):
     randomness comes only through `cpu` and the hedged source
  P9 no derive(Clone|Copy|Debug) on a type wrapping `Secret<` or
     `Zeroizing<` in rosenpass-core, pqkey-core, pds/pq, pds/pqkey,
     pds/ingress, and on any type in mce460896 but RngError, which keeps its
     secrets in plain arrays (L12, M3 plan S12, M4 plan C11; pqkey-core
     holds its secrets in `Zeroizing`), in tpm2 (M5 plan I10.3), in
     tls-core, pds/tls and key-core (M6 plan S9), in tlskey-core and
     pds/tlskey (M6 plan C12), and in `secret`, which defines the shared
     `Secret` itself (M6 Phase 2 self-check)
  P10 no `from_bytes(*` in the secret crates or in hs-core, key-core,
     data-core, wg-core, tpm2, tls-core, tlskey-core and the key, hs, data,
     tls and tlskey PDs: a dereferenced array is a by-value temporary of
     the secret left on the stack; `copy_from(&..)` copies in place (L12)
  P11 no cookie (COOKIE_FILES, M3b plan S3) and no tag of a TAG_SETS crate
     (any source in it: tpm2's HMAC tags, its Unseal response check, M5
     plan I10.1; tlskey-core's RFC 6979 HMAC and pds/tlskey's, M6 plan
     C12; pds/tls's HMAC tags; tls-core's Finished verify_data, M6 plan S9)
     compared with == or !=; every compare goes
     through ct_eq. Each set names an anchor file that must exist while its
     crate does (the file holding the check today). A tripwire: the names
     it reads are lowercase `cookie`/`hmac`/`tag`/`finished`/`verify_data`,
     and only `==` and `!=` are matched (not `.eq()` or a wrapper)
  P12 in every crate of the Makefile's verus_crates, the Verus trusted
     constructs equal policy/verus-trusted.toml as a multiset of (file,
     construct, item), by tools/verus_trusted.py's comparison, the one the
     Verus gate makes (M4 plan C1, C11)
  P13 no classic-mceliece-rust as a dependency key in any tracked
     Cargo.toml or Cargo.lock, nor as a Rust use/extern crate/path in crates/
     or tools/ (M4 plan C11)
  P14 no `unsafe` in crates/mce460896 outside src/barrier.rs (M4 plan C7)
  P15 no valgrind client-request preamble (`ror x12, x12, #3`) in crates/
     or tools/ outside tools/ct-harness/src/vg.rs (M4 plan C9)
  P16 crates/mce460896's dependencies, as resolved: its [dependencies]
     name the packages sha3 and zeroize (by `package`, not key), from the
     registry, with default features off and no features named, and it has
     no build- or target-specific dependency table; the workspace has no
     [replace] and no [patch] except crates.io's vstd/verus_* crates, each
     to path third_party/verus/<name> (M5 plan C5), nor .cargo/config(.toml) a [patch] or [source]
     replacement, nor mce460896 a [features] table, nor any other member a
     sha3/zeroize with features (they unify); and the lock's closure of
     the two is exactly MCE_CLOSURE (M4 plan C7). The lock stands for
     `cargo metadata`: every gate builds --locked, and the fixtures' partial
     trees could not be resolved by cargo.
  (P17, the sign cost's lock pin, was retired with C5's key-wait bound:
     M6 plan C12. The numbers that follow keep their names.)
  P18 L14's constructor rule (M6 plan L14, C7): in crates/ and tools/, a
     `HybridSecret(..)`/`HybridSecret { .. }` construction only inside
     `exchange_with_randomness` in crates/tls-core/src/hybrid.rs (the body
     `HybridSecret::exchange` delegates to), no `Self(..)`/`Self { .. }` in
     that file, no `impl .. for HybridSecret` (From, Default, Clone, ...)
     and no derive on it
  P19 a classical key-exchange group's code point in crates/tls-core
     (L14, S6): secp256r1..secp521r1, x25519, x448, brainpool and ffdhe as
     a 4-digit hex literal (0x0017, 0x001D, 0x0100), x25519/x448 as 0x1d/0x1e,
     a byte pair (`0x00, 0x1d`, `0, 29`), a u16-suffixed decimal (`23u16`) or
     a bare `29`

Pending rules (PENDING) run and print "pending <rule> ..." lines but do not
fail until they are removed from PENDING; --enforce-pending makes them fail
now (the fixtures use it). None is pending: P7 became enforced once
wg-core, hs-core and key-core dropped PSK_MIX in M3a.

Control class: P1-P4 are fail-closed checks over the files they read. P5 is
a best-effort tripwire: make and bash decide what a recipe does, and a
pattern list cannot enumerate every spelling. Known bypasses it does not
catch: an error-ignore prefix supplied through a variable (`$(D)cmd` with
D := -) and masks built from variables or functions. The adjudicating
control for "a failing gate fails `make check`" is tools/check-selftest's
check-propagation case, which runs the real `make check` once per gate with
that gate made to fail.

P6 is a fail-closed binding check (Cargo.lock against
policy/waivers.toml).
P7-P11 and P19 are best-effort tripwires over source text; P19's known
bypasses: a code point computed (`0x10 + 13`), built from bytes out of
order, read from configuration, or spelled in a dependency. L14's
adjudicating control is the type system: `KeySchedule::new` takes only a
`HybridSecret`, whose field is private and which is not Clone/Copy/Default
(tls-core's compile_fail doctests); P18 guards the one module that can
construct it.
P7-P10 are best-effort tripwires over source text. Known bypasses: a
hand-written `impl Debug`/`impl Clone` or a macro-generated derive (P9), a
`use ... as` alias or a renamed dependency key (`package = "getrandom"`)
(P8), spellings outside the pattern (P7), and any by-value copy not
spelled `from_bytes(*` (P10: `from_bytes(local)` of a secret array, or a
copy a dependency's by-value API forces, such as libcrux's encapsulation
randomness; safe Rust cannot observe stack residue, so nothing
adjudicates it). The adjudicating control for
L12 is the compiler: `Secret<N>` is not Clone/Copy/Debug, so a derive on a
type wrapping it does not build; `Zeroizing<[u8; N]>` is Clone, so P9 is
the only guard for pqkey-core's wrappers. L8's adjudicating control is
`PskTable::fresh` being the only constructor of `FreshPsk`.
"""

import argparse
import collections
import pathlib
import re
import sys
import tomllib

sys.dont_write_bytecode = True
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import waivers  # noqa: E402

RULES = ["P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8", "P9", "P10", "P11", "P12", "P13", "P14", "P15", "P16", "P18",
         "P19"]
# Crates whose secrets must not be copied by value (P10).
COPY_CRATES = ["crates/hs-core", "crates/key-core", "crates/data-core", "crates/wg-core", "crates/tpm2",
               "crates/tls-core", "crates/tlskey-core", "crates/pds/key", "crates/pds/hs", "crates/pds/data",
               "crates/pds/tls", "crates/pds/tlskey"]
PENDING: set[str] = set()
# Crates whose secret-holding types must not be Clone/Copy/Debug (P9).
SECRET_CRATES = ["crates/rosenpass-core", "crates/pqkey-core", "crates/pds/pq", "crates/pds/pqkey", "crates/pds/ingress",
                 "crates/mce460896", "crates/tpm2", "crates/tls-core", "crates/pds/tls", "crates/key-core",
                 "crates/tlskey-core", "crates/pds/tlskey", "crates/secret"]
# mce460896's types that hold no secret (P9): every other type there does.
MCE_PUBLIC_TYPES = {"RngError"}
# Types that hold a secret under a name of their own, not as Secret<..> (P9,
# M3b plan A1): the WireGuard cookie secret.
SECRET_TYPES = ("Secret<", "Zeroizing<", "CookieSecret")
# Files that compare cookie values; every compare goes through ct_eq (P11,
# M3b plan S3). A tripwire over names: a value not named *cookie* escapes it.
COOKIE_FILES = ["crates/rosenpass-core/src/cookie.rs", "crates/pds/ingress/src/rp_cookie.rs"]
# Crates whose every source file must compare tags with ct_eq (P11): the
# whole crate, so a check that moves out of its file stays covered; the
# anchor, the file holding the check today, must exist while the crate
# does. (crate, anchor, names, what): tpm2's Unseal response HMAC (M5 plan
# I10.1), the RFC 6979 HMAC in tlskey-core and its PD's (M6 plan C12; it
# was key-core's until then), pds/tls's HMAC tags, and tls-core's Finished,
# verified in handshake.rs (M6 plan S9, T-N1).
TAG_SETS = [
    ("crates/tpm2", "crates/tpm2/src/client.rs", "hmac|tag", "an HMAC tag"),
    ("crates/tlskey-core", "crates/tlskey-core/src/lib.rs", "hmac|tag", "an HMAC tag"),
    ("crates/pds/tlskey", "crates/pds/tlskey/src/main.rs", "hmac|tag", "an HMAC tag"),
    ("crates/pds/tls", "crates/pds/tls/src/main.rs", "hmac|tag|finished|verify_data", "a tag or Finished"),
    ("crates/tls-core", "crates/tls-core/src/handshake.rs", "finished|verify_data", "a Finished verify_data"),
]
# L14 (P18): the one module, and the one function in it, that construct
# HybridSecret.
HYBRID_MODULE = "crates/tls-core/src/hybrid.rs"
HYBRID_ROOT = "exchange_with_randomness"
# P19: where the classical code points must not appear.
CODE_POINT_CRATE = "crates/tls-core"


def run_blocks(dockerfile: str):
    """Yields (start_line, text) for each RUN instruction incl. continuations."""
    lines = dockerfile.splitlines()
    i = 0
    while i < len(lines):
        if lines[i].lstrip().startswith("RUN "):
            start, buf = i + 1, [lines[i]]
            while lines[i].rstrip().endswith("\\") and i + 1 < len(lines):
                i += 1
                buf.append(lines[i])
            yield start, "\n".join(buf)
        i += 1


def check_dockerfile(text: str, out: list):
    for n, line in enumerate(text.splitlines(), 1):
        if re.match(r"\s*ADD\s+(\S+\s+)*https?://", line):
            out.append(f"P1 docker/Dockerfile:{n}: ADD from a URL is not hash-checked")
    for start, block in run_blocks(text):
        for m in re.finditer(r"\bgit\s+clone\b[^\n]*", block):
            out.append(f"P1 docker/Dockerfile:{start}: git clone is not hash-pinned; download a release archive")
        # A command, not a package name in an apt list ("curl \\").
        for m in re.finditer(r"\b(curl|wget)\s+(?!\\)\S[^\n]*", block):
            line = m.group(0)
            if re.search(r"\|\s*(ba|z|da)?sh\b", line):
                out.append(f"P2 docker/Dockerfile:{start}: download piped into a shell")
                continue
            # The hash check must name the downloaded file itself, not just
            # appear somewhere later in the block.
            target = re.search(r"(?:-o|-O|--output)\s+(\S+)", line)
            if not target:
                out.append(f"P1 docker/Dockerfile:{start}: download without -o <file> to hash-check")
                continue
            name = target.group(1).strip('"')
            checked = any(name in l and "sha256sum -c" in l for l in block[m.end():].splitlines())
            if not checked:
                out.append(f"P1 docker/Dockerfile:{start}: {name} downloaded without its own sha256sum -c")


def check_cargo(path: pathlib.Path, rel: str, out: list):
    for n, line in enumerate(path.read_text().splitlines(), 1):
        if "git" not in line or "=" not in line or not re.search(r"\bgit\s*=", line):
            continue
        if re.search(r"\b(branch|tag)\s*=", line):
            out.append(f"P3 {rel}:{n}: git dependency uses branch/tag")
        if not re.search(r'\brev\s*=\s*"[0-9a-f]{40}"', line):
            out.append(f"P3 {rel}:{n}: git dependency without a 40-hex rev")


def check_toolchain(docker: str, toolchain: str, out: list):
    d = re.search(r"^ARG PD_TOOLCHAIN=(\S+)", docker, re.M)
    t = re.search(r'^channel\s*=\s*"([^"]+)"', toolchain, re.M)
    if not d or not t or d.group(1) != t.group(1):
        out.append(f"P4 PD_TOOLCHAIN ({d and d.group(1)}) != rust-toolchain.toml ({t and t.group(1)})")


def check_makefile(text: str, rel: str, out: list):
    if not re.search(r"^SHELL\s*:?=\s*bash\b", text, re.M):
        out.append(f"P5 {rel}: SHELL is not bash")
    if not re.search(r"^\.SHELLFLAGS\s*:?=\s*-euo pipefail -c\s*$", text, re.M):
        out.append(f"P5 {rel}: .SHELLFLAGS is not '-euo pipefail -c'")
    # Group physical lines into logical lines the way GNU make does: a line
    # continues only when it ends in an odd number of backslashes, with
    # nothing (not even a space) after them.
    logical = []  # (first physical line number, [physical lines])
    continues = False
    for n, line in enumerate(text.splitlines(), 1):
        if continues:
            logical[-1][1].append(line)
        else:
            logical.append((n, [line]))
        trailing = len(line) - len(line.rstrip("\\"))
        continues = trailing % 2 == 1
    for n, lines in logical:
        first = lines[0]
        # What bash receives from a recipe line: make keeps `\<newline>` but
        # strips the recipe tab from each continuation line, and bash then
        # deletes `\<newline>`, so tokens split across lines run joined.
        joined = lines[0][:-1] if len(lines) > 1 else lines[0]
        for i, l in enumerate(lines[1:], 1):
            l = l.removeprefix("\t")
            joined += l[:-1] if i < len(lines) - 1 else l
        # Outside recipes make replaces `\<newline>` and surrounding
        # whitespace with a single space.
        make_joined = " ".join(l.removesuffix("\\").strip() for l in lines)
        if not first.startswith("\t"):
            directive = make_joined
        else:
            directive = first
        if re.match(r"^\.IGNORE\b", directive):
            out.append(f"P5 {rel}:{n}: .IGNORE")
        if re.match(r"^\.RECIPEPREFIX\b", directive):
            out.append(f"P5 {rel}:{n}: .RECIPEPREFIX changes what a recipe line is")
        # Inline recipe: `target: prereqs ; -cmd`.
        if not first.startswith("\t") and re.match(r"^[^#=]*:[^=]*;\s*[@+]*-", first):
            out.append(f"P5 {rel}:{n}: inline recipe error-ignore prefix")
        if re.match(r"^MAKEFLAGS\b.*(\s|^|=)-[a-zA-Z]*[ik]", directive):
            out.append(f"P5 {rel}:{n}: MAKEFLAGS ignores errors")
        # make honours @/+/- (after optional whitespace) at the start of a
        # logical recipe line only.
        if re.match(r"^\t[\s@+]*-", first):
            out.append(f"P5 {rel}:{n}: recipe error-ignore prefix")
        if re.search(r"\|\|\s*(true|:|exit\s+0+)(?![\w-])|;\s*true\b|\bset \+e\b", joined):
            out.append(f"P5 {rel}:{n}: masked exit status")

def check_waivers(root: pathlib.Path, out: list):
    try:
        listed = waivers.load(root / "policy/waivers.toml")
    except waivers.WaiverError as e:
        out.append(f"P6 policy/waivers.toml: {e}")
        return
    try:
        required = waivers.required_open((root / "Cargo.lock").read_text())
    except (OSError, UnicodeDecodeError, waivers.WaiverError) as e:
        out.append(f"P6 Cargo.lock: cannot read: {e}")
        return
    for wid in waivers.unmet(required, listed):
        out.append(f"P6 Cargo.lock requires waiver {wid} to be open, but policy/waivers.toml does not list it as open")


def crate_sources(root: pathlib.Path, rel: str):
    """Yields (relative path, text) for *.rs and Cargo.toml under root/rel."""
    base = root / rel
    if not base.is_dir():
        return
    for p in sorted(base.rglob("*")):
        if p.is_file() and (p.suffix == ".rs" or p.name == "Cargo.toml") and \
                not any(part in ("target", "build") for part in p.relative_to(root).parts):
            yield str(p.relative_to(root)), p.read_text()


def check_forbidden(root: pathlib.Path, out: list):
    for rel, text in crate_sources(root, "crates"):
        for n, line in enumerate(text.splitlines(), 1):
            if re.search(r"(?i)psk_?mix", line):
                out.append(f"P7 {rel}:{n}: psk_mix (the static PSK path is removed)")
            if re.search(r"getrandom|thread_rng|OsRng", line):
                out.append(f"P8 {rel}:{n}: randomness outside cpu and the hedged source")


def item_after(text: str, pos: int) -> str:
    """The text of the first struct/enum/union item after pos, through its
    matching closing brace/paren or terminating ';'."""
    m = re.compile(r"\b(struct|enum|union)\b").search(text, pos)
    if not m:
        return ""
    depth = 0
    for i in range(m.end(), len(text)):
        c = text[i]
        if c in "{(":
            depth += 1
        elif c in "})":
            depth -= 1
            if depth == 0 and c == "}":
                return text[m.start():i + 1]
        elif c == ";" and depth == 0:
            return text[m.start():i + 1]
    return text[m.start():]


def check_secret_copies(root: pathlib.Path, out: list):
    for crate in SECRET_CRATES + COPY_CRATES:
        for rel, text in crate_sources(root, crate):
            if not rel.endswith(".rs"):
                continue
            code = strip_rust_comments(text)
            unterminated("P10", rel, code, out)
            for m in re.finditer(r"\bfrom_bytes\(\s*\*", code):
                n = code.count("\n", 0, m.start()) + 1
                out.append(f"P10 {rel}:{n}: from_bytes(*..) copies a secret by value; use copy_from(&..)")


def check_secret_derives(root: pathlib.Path, out: list):
    for crate in SECRET_CRATES:
        for rel, text in crate_sources(root, crate):
            if not rel.endswith(".rs"):
                continue
            code = strip_rust_comments(text)
            unterminated("P9", rel, code, out)
            for m in re.finditer(r"\bderive\(([^)]*)\)", code):
                if not re.search(r"\b(Clone|Copy|Debug)\b", m.group(1)):
                    continue
                item = item_after(code, m.end())
                wrapped = next((w for w in SECRET_TYPES if w in item), None)
                # mce460896 holds its secrets in plain arrays, not in a
                # wrapper type: there every type but the listed public ones
                # counts as secret-holding.
                name = re.match(r"\s*(?:struct|enum|union)\s+(\w+)", item)
                if crate == "crates/mce460896" and name and name.group(1) not in MCE_PUBLIC_TYPES:
                    wrapped = wrapped or f"mce460896 state ({name.group(1)})"
                if wrapped:
                    n = code.count("\n", 0, m.start()) + 1
                    out.append(f"P9 {rel}:{n}: derive({m.group(1)}) on a type wrapping {wrapped}")


def check_cookie_compares(root: pathlib.Path, out: list):
    for rel in COOKIE_FILES:
        path = root / rel
        if not path.is_file():
            # A crate that exists without its cookie file has lost what this
            # rule checks; a tree without the crate (the P7 fixtures') has not.
            if (root / rel).parents[1].is_dir():
                out.append(f"P11 {rel}: missing; the cookie compare tripwire has nothing to check")
            continue
        code = strip_rust_comments(path.read_text())
        unterminated("P11", rel, code, out)
        for m in re.finditer(r"\b\w*cookie\w*\b[\])]*\s*[!=]=(?!=)|[!=]=\s*[&*]?\w*cookie\w*\b", code):
            n = code.count("\n", 0, m.start()) + 1
            out.append(f"P11 {rel}:{n}: a cookie compared with == or !=; use ct_eq")
    for crate, anchor, names, what in TAG_SETS:
        if (root / crate).is_dir() and not (root / anchor).is_file():
            out.append(f"P11 {anchor}: missing; the tag compare tripwire has nothing to check")
        pattern = re.compile(rf"\b\w*(?:{names})\w*\b[\])]*\s*[!=]=(?!=)|[!=]=\s*[&*]?\w*(?:{names})\w*\b")
        for rel, text in crate_sources(root, crate):
            if not rel.endswith(".rs"):
                continue
            code = strip_rust_comments(text)
            unterminated("P11", rel, code, out)
            for m in pattern.finditer(code):
                n = code.count("\n", 0, m.start()) + 1
                out.append(f"P11 {rel}:{n}: {what} compared with == or !=; use ct_eq")


def body_span(code: str, name: str):
    """The [start, end) of fn `name`'s body braces, or None."""
    m = re.search(rf"\bfn\s+{name}\b", code)
    if not m:
        return None
    start = code.find("{", m.end())
    depth = 0
    for i in range(start, len(code)):
        if code[i] == "{":
            depth += 1
        elif code[i] == "}":
            depth -= 1
            if depth == 0:
                return start, i + 1
    return start, len(code)


def check_hybrid_constructors(root: pathlib.Path, out: list):
    for top in ("crates", "tools"):
        for rel, text in crate_sources(root, top):
            if not rel.endswith(".rs"):
                continue
            code = strip_rust_comments(text)
            unterminated("P18", rel, code, out)
            line = lambda pos: code.count("\n", 0, pos) + 1
            allowed = body_span(code, HYBRID_ROOT) if rel == HYBRID_MODULE else None
            for m in re.finditer(r"\bHybridSecret\s*[({]", code):
                before = code[max(0, m.start() - 40):m.start()]
                if re.search(r"\b(struct|impl(\s*<[^>]*>)?|for)\s+$", before):
                    continue
                if allowed and allowed[0] <= m.start() < allowed[1]:
                    continue
                out.append(f"P18 {rel}:{line(m.start())}: HybridSecret constructed outside {HYBRID_ROOT} (L14)")
            for m in re.finditer(r"\bimpl\b[^{;]*?\bfor\s+(?:[\w:]+::)?HybridSecret\b", code):
                out.append(f"P18 {rel}:{line(m.start())}: a trait impl for HybridSecret can make or copy one (L14)")
            for m in re.finditer(r"\bderive\(([^)]*)\)", code):
                if re.match(r"\s*(?:#\[[^\]]*\]\s*)*(?:pub(?:\([^)]*\))?\s+)?struct\s+HybridSecret\b", code[m.end() + 1:]):
                    out.append(f"P18 {rel}:{line(m.start())}: derive({m.group(1)}) on HybridSecret (L14)")
            if rel == HYBRID_MODULE:
                for m in re.finditer(r"\bSelf\s*[({]", code):
                    out.append(f"P18 {rel}:{line(m.start())}: Self(..) constructs HybridSecret outside {HYBRID_ROOT} (L14)")
    module = root / HYBRID_MODULE
    if (root / CODE_POINT_CRATE).is_dir() and (not module.is_file() or body_span(module.read_text(), HYBRID_ROOT) is None):
        out.append(f"P18 {HYBRID_MODULE}: no {HYBRID_ROOT}; the constructor rule has nothing to anchor on")


# P19: classical groups (RFC 8446 section 4.2.7, RFC 8734, RFC 7919) as
# spelled in Rust source.
CLASSICAL_SPELLINGS = [
    (re.compile(r"\b0x00_?(?:1[7-9a-f]|2[01])\b", re.I), "a 4-digit hex code point"),
    (re.compile(r"\b0x01_?0[0-4]\b", re.I), "an ffdhe code point"),
    (re.compile(r"\b0x1[de]\b", re.I), "x25519/x448's low byte"),
    (re.compile(r"(?<![\w.])(?:0x0+|0)\s*,\s*(?:0x(?:1[7-9a-f]|2[01])|2[3-59]|30)(?![\w.])", re.I), "a code point's byte pair"),
    (re.compile(r"(?<![\w.])(?:2[3-9]|3[0-3]|25[6-9]|260)_?u16\b"), "a u16 code point"),
    (re.compile(r"(?<![\w.])29(?![\w.])"), "x25519's code point"),
]


def check_classical_groups(root: pathlib.Path, out: list):
    for rel, text in crate_sources(root, CODE_POINT_CRATE):
        if not rel.endswith(".rs"):
            continue
        code = strip_rust_comments(text)
        unterminated("P19", rel, code, out)
        for pattern, what in CLASSICAL_SPELLINGS:
            for m in pattern.finditer(code):
                n = code.count("\n", 0, m.start()) + 1
                out.append(f"P19 {rel}:{n}: {what} of a classical group ({m.group(0)!r}); L14 allows X25519MLKEM768 only")


def strip_rust_comments(text: str) -> str:
    """Comments and literals blanked by the Verus scanner's lexer (nested
    block comments, `b`/`c`/raw strings), so every source rule reads Rust the
    way rustc does and none can be desynchronised on its own (R48). An
    unterminated literal or comment leaves UNTERMINATED, which the rules
    report: rustc refuses it anyway, so it can only be there to hide code."""
    import verus_trusted
    return verus_trusted.strip_comments(text)


def unterminated(rule: str, rel, code: str, out: list):
    import verus_trusted
    for m in re.finditer(rf"\b{verus_trusted.UNTERMINATED}\b", code):
        out.append(f"{rule} {rel}:{code.count(chr(10), 0, m.start()) + 1}: unterminated literal or comment")


def check_verus_trusted(root: pathlib.Path, out: list):
    import verus_trusted
    m = re.search(r"^verus_crates :=(.*)$", (root / "Makefile").read_text(), re.M)
    crates = m.group(1).split() if m else []
    if not crates:
        out.append("P12 Makefile: no `verus_crates :=` list; nothing to check")
    policy = root / "policy/verus-trusted.toml"
    entries = tomllib.loads(policy.read_text()).get("trusted", []) if policy.is_file() else []
    for crate in crates:
        base = root / "crates" / crate
        # As P11: a crate that exists without its sources has lost what this
        # rule checks; a tree without the crate (the P7 fixtures') has not,
        # and the Verus gate fails on a listed crate that is gone.
        if not base.is_dir():
            continue
        if not (base / "src").is_dir():
            out.append(f"P12 crates/{crate}: listed in verus_crates but has no src/")
            continue
        # The Verus gate's own comparison (one adjudicator, R48).
        for e in verus_trusted.trusted_mismatches(crate, base, entries):
            out.append(f"P12 crates/{crate}/{e}")
    # Only the verified crates may depend on Verus's own crates: another
    # workspace crate could re-export `assume_` (as a `kani` module, say)
    # from sources this scan never reads.
    try:
        lock = tomllib.loads((root / "Cargo.lock").read_text())
    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError):
        lock = {}  # P6 reports it
    verus_deps = {"vstd", "verus_builtin", "verus_builtin_macros", "verus_state_machines_macros"}
    # The vendored Verus crates themselves (M5 plan C5) depend on each other.
    dependents = {p.get("name") for p in lock.get("package", [])
                  if "source" not in p and not VERUS_VENDORED.match(p.get("name", ""))
                  and verus_deps & {d.split()[0] for d in p.get("dependencies", [])}}
    if lock and crates:
        for name in sorted(dependents - set(crates)):
            out.append(f"P12 Cargo.lock: {name} depends on a Verus crate but is not in verus_crates")


def check_cmr_gone(root: pathlib.Path, out: list):
    for p in sorted(root.glob("**/Cargo.toml")) + sorted(root.glob("**/Cargo.lock")):
        rel = p.relative_to(root)
        if any(part in ("target", "build") for part in rel.parts):
            continue
        # An unreadable lock is P6's to report; read what is there.
        for n, line in enumerate(p.read_text(errors="replace").splitlines(), 1):
            if re.match(r'\s*(name\s*=\s*"classic-mceliece-rust"|classic-mceliece-rust\s*=|"classic-mceliece-rust["\s])', line):
                out.append(f"P13 {rel}:{n}: classic-mceliece-rust is a dependency")
    for top in ("crates", "tools"):
        for p in sorted((root / top).rglob("*.rs")) if (root / top).is_dir() else []:
            rel = p.relative_to(root)
            if any(part in ("target", "build") for part in rel.parts):
                continue
            code = strip_rust_comments(p.read_text())
            unterminated("P13", rel, code, out)
            for m in re.finditer(r"\b(use\s+|extern\s+crate\s+)?classic_mceliece_rust\b", code):
                if m.group(1) or code[m.end():m.end() + 2] == "::":
                    n = code.count("\n", 0, m.start()) + 1
                    out.append(f"P13 {rel}:{n}: classic_mceliece_rust used")


def check_mce_unsafe(root: pathlib.Path, out: list):
    base = root / "crates/mce460896/src"
    for p in sorted(base.rglob("*.rs")) if base.is_dir() else []:
        if p.name == "barrier.rs" and p.parent == base:
            continue
        code = strip_rust_comments(p.read_text())
        unterminated("P14", p.relative_to(root), code, out)
        for m in re.finditer(r"\bunsafe\b", code):
            if code[max(0, m.start() - 12):m.start()].endswith("deny("):
                continue
            n = code.count("\n", 0, m.start()) + 1
            out.append(f"P14 {p.relative_to(root)}:{n}: unsafe outside barrier.rs")


def check_client_requests(root: pathlib.Path, out: list):
    allowed = root / "tools/ct-harness/src/vg.rs"
    for top in ("crates", "tools"):
        for p in sorted((root / top).rglob("*.rs")) if (root / top).is_dir() else []:
            rel = p.relative_to(root)
            if p == allowed or any(part in ("target", "build") for part in rel.parts):
                continue
            for n, line in enumerate(p.read_text().splitlines(), 1):
                if re.search(r"ror\s+x12\s*,\s*x12\s*,\s*#\s*3\b", line):
                    out.append(f"P15 {rel}:{n}: valgrind client request outside tools/ct-harness/src/vg.rs")


# The lock's closure of mce460896's two dependencies (P16): a change to it
# is a change to what the McEliece code links, and is reviewed here. The
# lock does not record edge kinds, so build dependencies (version_check) and
# target-specific ones (libc, for cpufeatures) are in it.
MCE_CLOSURE = {"block-buffer@0.10.4", "cpufeatures@0.2.17", "crypto-common@0.1.7", "digest@0.10.7",
               "generic-array@0.14.7", "keccak@0.1.6", "libc@0.2.191", "sha3@0.10.9", "typenum@1.20.1",
               "version_check@0.9.5", "zeroize@1.8.1"}
REGISTRY = "registry+https://github.com/rust-lang/crates.io-index"
# The Verus crates vendored under third_party/verus (M5 plan C5).
VERUS_VENDORED = re.compile(r"^(vstd|verus_[a-z_]+)$")


def check_mce_deps(root: pathlib.Path, out: list):
    path = root / "crates/mce460896/Cargo.toml"
    if not path.is_file():
        return
    data = tomllib.loads(path.read_text())
    deps = data.get("dependencies", {})
    names = set()
    for key, spec in deps.items():
        spec = spec if isinstance(spec, dict) else {"version": spec}
        names.add(spec.get("package", key))
        extra = set(spec) - {"version", "default-features"}
        if spec.get("default-features", True) is not False:
            out.append(f"P16 crates/mce460896/Cargo.toml: dependency {key} keeps its default features")
        if extra:
            out.append(f"P16 crates/mce460896/Cargo.toml: dependency {key} has {sorted(extra)}; "
                       "a registry version only")
    if names != {"sha3", "zeroize"}:
        out.append(f"P16 crates/mce460896/Cargo.toml: dependencies resolve to {sorted(names)}, "
                   "want exactly ['sha3', 'zeroize']")
    for table in sorted(data):
        if table in ("target", "features") or table.replace("_", "-") == "build-dependencies":
            out.append(f"P16 crates/mce460896/Cargo.toml: [{table}] is not allowed")
    # Features unify across the workspace: every member's sha3/zeroize must
    # be featureless too, or it turns them on for mce460896 as well. (The
    # tool workspaces, rp-vectors and ct-harness, build on their own.)
    try:
        ws_doc = tomllib.loads((root / "Cargo.toml").read_text())
    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError):
        ws_doc = {}
    members = [root / "Cargo.toml"] + [root / m / "Cargo.toml" for m in ws_doc.get("workspace", {}).get("members", [])]
    for member in members:
        rel = member.relative_to(root)
        if rel == pathlib.Path("crates/mce460896/Cargo.toml"):
            continue
        if not member.is_file():
            out.append(f"P16 {rel}: workspace member without a Cargo.toml; its features cannot be checked")
            continue
        try:
            doc = tomllib.loads(member.read_text())
        except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError):
            continue  # P3/P6 report unreadable manifests
        tables = [doc.get("workspace", {}).get("dependencies", {})]
        for scope in [doc] + list(doc.get("target", {}).values()):
            for kind in ("dependencies", "dev-dependencies", "build-dependencies"):
                tables.append(scope.get(kind, {}))
        # Dependency keys that name sha3 or zeroize, by key or by `package`.
        guarded = set()
        ws_deps = ws_doc.get("workspace", {}).get("dependencies", {})
        for deps in tables:
            for key, spec in deps.items():
                spec = spec if isinstance(spec, dict) else {"version": spec}
                package = spec.get("package", key)
                if spec.get("workspace") is True:
                    # An inherited entry names its package in the workspace
                    # declaration, under the same key.
                    declared = ws_deps.get(key, {})
                    package = declared.get("package", key) if isinstance(declared, dict) else key
                if package not in ("sha3", "zeroize"):
                    continue
                guarded.add(key)
                if spec.get("workspace") is True:
                    # Inherited: its declaration is judged in
                    # [workspace.dependencies], but cargo adds the member's
                    # own features on top.
                    if spec.get("features") or spec.get("default-features", False) is not False:
                        out.append(f"P16 {rel}: {key} inherits from the workspace but adds features")
                    continue
                if spec.get("features") or spec.get("default-features", True) is not False:
                    out.append(f"P16 {rel}: {key} with features or default features unifies them into mce460896")
        for feature, enables in doc.get("features", {}).items():
            for e in enables:
                m = re.match(r"(?:dep:)?([A-Za-z0-9_-]+)\??/", str(e))
                if m and (m.group(1) in guarded or m.group(1) in ("sha3", "zeroize")):
                    out.append(f"P16 {rel}: feature {feature} turns on {e}, which unifies into mce460896")
    ws = tomllib.loads((root / "Cargo.toml").read_text())
    if "replace" in ws:
        out.append("P16 Cargo.toml: [replace] can redirect mce460896's dependencies")
    # The one permitted [patch] (M5 plan C5): crates.io's Verus crates, each to
    # its vendored copy. None of them is in mce460896's closure.
    for registry, entries in ws.get("patch", {}).items():
        for key, spec in (entries.items() if isinstance(entries, dict) else []):
            vendored = registry == "crates-io" and VERUS_VENDORED.match(key) \
                and spec == {"path": f"third_party/verus/{key}"}
            if not vendored:
                out.append(f"P16 Cargo.toml: [patch.{registry}] {key} can redirect mce460896's dependencies")
        if not isinstance(entries, dict):
            out.append(f"P16 Cargo.toml: [patch.{registry}] is not a table")
    # A config [patch] would show in the lock; source replacement would not.
    for config in (root / ".cargo/config.toml", root / ".cargo/config"):
        if not config.is_file():
            continue
        name = config.relative_to(root)
        try:
            cfg = tomllib.loads(config.read_text())
        except (UnicodeDecodeError, tomllib.TOMLDecodeError) as e:
            out.append(f"P16 {name}: unreadable ({e})")
            cfg = {}
        for table in ("patch", "source"):
            if table in cfg:
                out.append(f"P16 {name}: [{table}] can redirect mce460896's dependencies")
        # `--cfg feature="..."` in rustflags turns features on behind the
        # manifests' back.
        flagged = [k for k in ("build",) if "rustflags" in cfg.get(k, {})] + \
                  [f"target.{t}" for t, v in cfg.get("target", {}).items() if isinstance(v, dict) and "rustflags" in v]
        for where in flagged:
            out.append(f"P16 {name}: rustflags in [{where}] can turn on features unseen")
    try:
        lock = tomllib.loads((root / "Cargo.lock").read_text())
    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError) as e:
        out.append(f"P16 Cargo.lock: unreadable ({e}); the closure cannot be checked")
        return
    packages = collections.defaultdict(list)
    for p in lock.get("package", []):
        packages[p.get("name")].append(p)

    def resolve(dep: str):
        name, *version = dep.split()
        found = [p for p in packages[name] if not version or p.get("version") == version[0]]
        return found[0] if len(found) == 1 else None

    mine = [p for p in packages["mce460896"] if "source" not in p]
    if len(mine) != 1:
        out.append(f"P16 Cargo.lock: mce460896 locked {len(mine)} times")
        return
    todo = [d for d in mine[0].get("dependencies", []) if d.split()[0] in names]
    if sorted(d.split()[0] for d in todo) != sorted(names):
        out.append(f"P16 Cargo.lock: mce460896 locks {sorted(mine[0].get('dependencies', []))}, "
                   f"not its dependencies {sorted(names)}")
    closure = set()
    while todo:
        dep = todo.pop()
        p = resolve(dep)
        if p is None:
            out.append(f"P16 Cargo.lock: {dep} does not resolve to one package")
            continue
        key = f"{p['name']}@{p['version']}"
        if key in closure:
            continue
        closure.add(key)
        if p.get("source") != REGISTRY:
            out.append(f"P16 Cargo.lock: {key} is not from the crates.io registry")
        elif not p.get("checksum"):
            out.append(f"P16 Cargo.lock: {key} has no checksum")
        todo += p.get("dependencies", [])
    for key in sorted(closure - MCE_CLOSURE):
        out.append(f"P16 Cargo.lock: {key} entered mce460896's dependency closure")
    for key in sorted(MCE_CLOSURE - closure):
        out.append(f"P16 Cargo.lock: {key} left mce460896's dependency closure")


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--root", default=".")
    ap.add_argument("--enforce-pending", action="store_true")
    args = ap.parse_args()
    root = pathlib.Path(args.root)
    pending = set() if args.enforce_pending else PENDING
    out: list = []
    docker = (root / "docker/Dockerfile").read_text()
    check_dockerfile(docker, out)
    for p in sorted(root.glob("**/Cargo.toml")):
        if any(part in ("target", "build") for part in p.parts):
            continue
        check_cargo(p, str(p.relative_to(root)), out)
    check_toolchain(docker, (root / "rust-toolchain.toml").read_text(), out)
    check_makefile((root / "Makefile").read_text(), "Makefile", out)
    check_waivers(root, out)
    check_forbidden(root, out)
    check_secret_derives(root, out)
    check_secret_copies(root, out)
    check_cookie_compares(root, out)
    check_verus_trusted(root, out)
    check_cmr_gone(root, out)
    check_mce_unsafe(root, out)
    check_client_requests(root, out)
    check_mce_deps(root, out)
    check_hybrid_constructors(root, out)
    check_classical_groups(root, out)
    failing = [l for l in out if l.split()[0] not in pending]
    for line in out:
        print(line if line in failing else f"pending {line}")
    print(f"CHECK-PINS-RULES {len([r for r in RULES if r not in pending])}")
    return 1 if failing else 0


if __name__ == "__main__":
    sys.exit(main())
