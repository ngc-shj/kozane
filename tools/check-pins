# P27, P28: the peer-policy slots and the signer (M8 plan C1, C2).
VERIFIER_USERS = ("crates/pds/policy/Cargo.toml", "tools/policy/Cargo.toml")
SLOT_READERS = ("crates/pds/policy/", "crates/policy-client/")
SLOT_SYMBOL = re.compile(r"memory_region_symbol!\(\s*policy_[ab]\b")
# `Verified::from_reply` builds a token from any bytes, so only the client
# that decodes the `policy` PD's reply calls it (and policy-wire's tests).
TOKEN_MAKERS = ("crates/policy-wire/", "crates/policy-client/")
TOKEN_FROM_REPLY = re.compile(r"\bfrom_reply\s*\(")
# A flag the signer would parse is a string literal; skip_approval is an
# identifier. Comment lines may name them (the tool's own docs do).
BYPASS_FLAG = re.compile(r"[\"']--(force|single|roster)[\"']|\bskip_approval\b")


def verifier_users_in(manifest: dict, ws_deps: dict) -> list:
    """Where a parsed Cargo.toml turns on policy-wire's `verifier`: a
    dependency entry with it (inherited ones too), a `[features]` entry
    naming it through any key that is policy-wire, and, in policy-wire's own
    manifest, any feature but `verifier` itself that includes it."""
    names, found = {"policy-wire"}, []
    for table, key, spec, package in dependency_entries(manifest, ws_deps):
        if package is None and "verifier" in (spec.get("features") or []):
            found.append(f"[{table}.{key}] features (inherited, but the workspace declares no {key})")
            continue
        if package != "policy-wire":
            continue
        names.add(key)
        if "verifier" in (spec.get("features") or []):
            found.append(f"[{table}.{key}] features")
    own = manifest.get("package", {}).get("name") == "policy-wire"
    for feature, enables in (manifest.get("features") or {}).items():
        for e in enables if isinstance(enables, list) else []:
            dep, _, feat = str(e).removeprefix("dep:").partition("/")
            if (feat == "verifier" and dep.rstrip("?") in names) or (own and e == "verifier" and feature != "verifier"):
                found.append(f"[features] {feature}")
    return found


def check_policy(root: pathlib.Path, out: list):
    try:
        ws_deps = tomllib.loads((root / "Cargo.toml").read_text()).get("workspace", {}).get("dependencies", {})
    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError):
        ws_deps = {}
    # A PD's per-build features (Makefile `features_<pd>`) reach policy-wire
    # through cargo's `dep/feature` syntax too.
    makefile = root / "Makefile"
    for n, line in enumerate(makefile.read_text().splitlines() if makefile.is_file() else [], 1):
        if re.search(r"\bfeatures_[A-Za-z0-9_-]+\s*[:+?]?=\s*[^\s#]*\bverifier\b", line.split("#", 1)[0]):
            out.append(f"P27 Makefile:{n}: a PD build's features name verifier (M8 plan C1)")
    for p in sorted(root.glob("**/Cargo.toml")):
        rel = str(p.relative_to(root))
        if any(part in ("target", "build", "third_party") for part in p.relative_to(root).parts) or rel in VERIFIER_USERS:
            continue
        # Parsed, not read by line: a `[dependencies.policy-wire]` table, a
        # renamed dependency (`package = "policy-wire"`) or a target table
        # all enable the feature too.
        try:
            manifest = tomllib.loads(p.read_text())
