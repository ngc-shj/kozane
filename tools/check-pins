# P39: D12's lock pin. (lock, reference, the failure's name)
LOCK_PINS = (("client/Cargo.lock", "Cargo.lock", "client"), ("host/Cargo.lock", "tools/release/Cargo.lock", "host"),
             ("tools/rp-residue/Cargo.lock", "Cargo.lock", "rp-residue"))


def lock_packages(path: pathlib.Path) -> dict:
    out = collections.defaultdict(set)
    # A package without a name or version is P6's to report.
    for pkg in tomllib.loads(path.read_text()).get("package", []):
        if isinstance(pkg, dict) and "name" in pkg and "version" in pkg:
            out[pkg["name"]].add((pkg["version"], pkg.get("source"), pkg.get("checksum")))
    return out


def check_lock_pins(root: pathlib.Path, out: list):
    for lock, reference, what in LOCK_PINS:
        try:
            ours, theirs = lock_packages(root / lock), lock_packages(root / reference)
        except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError) as e:
            out.append(f"P39 pins: {what} lock drift: cannot read {lock} or {reference} ({e})")
            continue
        for name in sorted(set(ours) & set(theirs)):
            for version, source, checksum in sorted(ours[name] - theirs[name], key=str):
                out.append(f"P39 pins: {what} lock drift: {lock} locks {name} {version} ({checksum}), {reference} "
                           f"has {', '.join(sorted(v for v, _, _ in theirs[name]))} (M9 plan D12)")


