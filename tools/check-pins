# P31: audit calls auditkey from one place, after ready_input.
AUDIT_MAIN = "crates/pds/audit/src/main.rs"


def check_audit_call(root: pathlib.Path, out: list):
    path = root / AUDIT_MAIN
    if not path.is_file():
        return
    # The shared lexer, so a `//` inside a string hides nothing (R48).
    stripped = strip_rust_comments(path.read_text())
    unterminated("P31", AUDIT_MAIN, stripped, out)
    code = stripped.splitlines()
    # One source file: a module beside main.rs, or code pulled in from
    # elsewhere, could call `sign` unseen.
    # Over the whole text, not by line. audit is one file with no modules,
    # so any `mod` token (split, raw, macro-generated), any `include` token
    # (an alias, `use core::include as x;`, is one too) and any attribute
    # with a `path` key is refused outright.
    # Also refused: metavariable expressions (`${concat(..)}` builds an
    # `include` or `sign` from parts no token rule sees) and any
    # `#![feature]` that would enable them; audit uses neither.
    for m in re.finditer(r"\bmod\b|\binclude\b|#\s*!?\s*\[[^\]]*\bpath\b", stripped):
        n = stripped.count("\n", 0, m.start()) + 1
        out.append(f"P31 {AUDIT_MAIN}:{n}: an out-of-line module or include! pulls in code the one-call-site check does not read (M8 plan C10)")
    # Any inner attribute naming `feature` (`cfg_attr` included).
    for m in re.finditer(r"\$\s*\{|#\s*!\s*\[[^\]]*\bfeature\b", stripped):
        n = stripped.count("\n", 0, m.start()) + 1
        out.append(f"P31 {AUDIT_MAIN}:{n}: a metavariable expression or feature gate can build a name no P31 token rule sees (M8 plan C10)")
    others = sorted(str(f.relative_to(root)) for f in path.parent.rglob("*.rs") if f != path)
    if others:
        out.append(f"P31 {AUDIT_MAIN}: audit has other source files {others}; its one call site is only checked in main.rs (M8 plan C10)")
    # Every `pp_call` token over the whole text (spacing, `Channel::pp_call`
    # and a split call are one too), and the plain spellings of another
    # way in: an endpoint, sel4, a channel number written as a literal. A
    # computed number or `asm!` passes (a tripwire, D-24).
    calls = [stripped.count("\n", 0, m.start()) + 1 for m in re.finditer(r"\bpp_call\b", stripped)]
    for m in re.finditer(r"\bendpoint\b|\bsel4\b|\bChannel\s*::\s*new\s*\(\s*\d", stripped):
        n = stripped.count("\n", 0, m.start()) + 1
        out.append(f"P31 {AUDIT_MAIN}:{n}: an endpoint, sel4 or a literal channel number reaches auditkey past the one call (M8 plan C10)")
    names = [n for n, l in enumerate(code, 1) if "CH_AUDITKEY" in l]
    sign = next((n for n, l in enumerate(code, 1) if re.search(r"\bfn sign\(", l)), None)
    end = next((n for n, l in enumerate(code, 1) if sign and n > sign and l.startswith("}")), None)
    if len(calls) != 1 or not (sign and end and sign < calls[0] < end):
        out.append(f"P31 {AUDIT_MAIN}: want exactly one pp_call, inside fn sign; found lines {calls} (M8 plan C10)")
    if names != calls:
        out.append(f"P31 {AUDIT_MAIN}: CH_AUDITKEY named at lines {names}; only at the one call (M8 plan C10)")
    # `sign` takes any words, so its one use must be the machine's
    # `Action::Call(words) =>` arm, within three lines after it: every
    # `sign` token but the definition counts, so `let f = sign;` or
    # `.map(sign)` is a second use too.
    sign_calls = [n for n, l in enumerate(code, 1) if re.search(r"\bsign\b", re.sub(r"\bfn sign\(", "", l))]
    arm = [n for n, l in enumerate(code, 1) if re.search(r"\bAction::Call\(words\)\s*=>", l)]
    if len(sign_calls) != 1 or len(arm) != 1 or not (arm[0] < sign_calls[0] <= arm[0] + 3):
        out.append(f"P31 {AUDIT_MAIN}: want exactly one use of sign, a call in the Action::Call(words) arm; "
                   f"found calls {sign_calls}, arms {arm} (M8 plan C10)")
    # F32's ready gate in the glue: the one argument-less `notified()` (the
    # checkpoint machine's) sits on the line after the `ready_input` test.
    gate = [n for n, l in enumerate(code, 1) if re.search(r"\bif\s+audit_core::ready_input\(", l)]
    marks = [stripped.count("\n", 0, m.start()) + 1 for m in re.finditer(r"\bnotified\s*\(\s*\)", stripped)]
    if len(gate) != 1 or marks != [gate[0] + 1]:
        out.append(f"P31 {AUDIT_MAIN}: want the checkpoint machine's notified() only right under the ready_input test; "
                   f"found tests {gate}, calls {marks} (M8 plan C10, F32)")
    if not any("audit_core::ready_input(" in l for l in code):
        out.append(f"P31 {AUDIT_MAIN}: the notification is not decoded by audit_core::ready_input (M8 plan C10)")


