C1_SKIP = ("docs/archive", "build", "target", ".git", ".claude", "third_party")


def tree_files(root: pathlib.Path, skip: tuple):
    for dirpath, dirnames, filenames in os.walk(root):
        rel_dir = pathlib.Path(dirpath).relative_to(root).as_posix()
        dirnames[:] = sorted(d for d in dirnames if not d.startswith("target")
                             and (f"{rel_dir}/{d}" if rel_dir != "." else d) not in skip and d not in skip)
        for name in sorted(filenames):
            yield pathlib.Path(dirpath) / name


def check_c1_patterns(root: pathlib.Path, out: list):
    for p in tree_files(root, C1_SKIP):
        rel = p.relative_to(root).as_posix()
        if rel in C1_ALLOWED:
            continue
        try:
            text = p.read_text()
        except (UnicodeDecodeError, OSError):
            continue
        for n, line in enumerate(text.splitlines(), 1):
            if (m := C1_PATTERNS.search(line)):
                out.append(f"P37 {rel}:{n}: {m.group(0)} outside tools/vm.py; the QEMU command line is "
                           "vm.machine's alone (M9 plan C1)")


