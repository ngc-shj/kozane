# P34: upstream's name -> (initiator_state.rs's constants, the scale from
# upstream's seconds). A pair is a fraction NUM / DEN.
RP_CONSTANTS_EXCERPT = f"{RP_VECTOR_DIR}/upstream-constants.txt"
RP_CONSTANTS_SRC = "crates/rosenpass-core/src/initiator_state.rs"
RP_CONSTANTS = {
    "RETRANSMIT_DELAY_BEGIN": (("RETRANSMIT_DELAY_BEGIN_NS",), 10**9),
    "RETRANSMIT_DELAY_GROWTH": (("RETRANSMIT_DELAY_GROWTH",), 1),
    "RETRANSMIT_DELAY_END": (("RETRANSMIT_DELAY_END_NS",), 10**9),
    "RETRANSMIT_DELAY_JITTER": (("RETRANSMIT_DELAY_JITTER_NUM", "RETRANSMIT_DELAY_JITTER_DEN"), 1),
    "REJECT_AFTER_TIME": (("REJECT_AFTER_TIME_NS",), 10**9),
    "REKEY_AFTER_TIME_INITIATOR": (("REKEY_AFTER_TIME_INITIATOR_NS",), 10**9),
}
UPSTREAM_LINE = re.compile(r"^(\S+):(\d+) pub const ([A-Z_]+): Timing = ([0-9]+(?:\.[0-9]+)?);$")
RUST_CONST = re.compile(r"^((?:[ \t]*///.*\n)*)[ \t]*(?:pub )?const ([A-Z_0-9]+): u64 = ([^;]+);", re.M)


def check_rp_constants(root: pathlib.Path, out: list):
    if not (root / "crates/rosenpass-core").is_dir():
        return
    Fraction = fractions.Fraction
    drift = "P34 rp-constants: drift:"
    excerpt, src = root / RP_CONSTANTS_EXCERPT, root / RP_CONSTANTS_SRC
    if not excerpt.is_file() or not src.is_file():
        out.append(f"{drift} {RP_CONSTANTS_EXCERPT} or {RP_CONSTANTS_SRC} missing")
        return
    text = excerpt.read_text()
    docker = (root / "docker/Dockerfile").read_text()
    for arg in ("RP_MASTER_COMMIT", "RP_MASTER_SHA256"):
        m = re.search(rf"^ARG {arg}=([0-9a-f]+)$", docker, re.M)
        if not m or m.group(1) not in text:
            out.append(f"{drift} {RP_CONSTANTS_EXCERPT} does not name docker/Dockerfile's {arg}")
    upstream = {}
    for line in text.splitlines():
        if line.startswith("#") or not line.strip():
            continue
        m = UPSTREAM_LINE.match(line)
        if not m or m.group(3) not in RP_CONSTANTS or m.group(3) in upstream:
            out.append(f"{drift} {RP_CONSTANTS_EXCERPT}: unexpected line `{line}`")
            continue
        upstream[m.group(3)] = (m.group(2), Fraction(m.group(4)))
    rust = {m.group(2): (m.group(1), m.group(3)) for m in RUST_CONST.finditer(src.read_text())}

    def value(name: str, seen=()):
        if name not in rust or name in seen:
            return None
        product = 1
        for factor in (f.strip() for f in rust[name][1].split("*")):
            if re.fullmatch(r"[0-9_]+", factor):
                product *= int(factor.replace("_", ""))
            elif (v := value(factor, (*seen, name))) is not None:
                product *= v
            else:
                return None
        return product

    for name, (ours, scale) in RP_CONSTANTS.items():
        if name not in upstream:
            out.append(f"{drift} {RP_CONSTANTS_EXCERPT} has no line for upstream {name}")
            continue
        line, want = upstream[name]
        vals = [value(c) for c in ours]
        if None in vals:
            out.append(f"{drift} {RP_CONSTANTS_SRC}: {' / '.join(ours)} not a product of literals and constants")
            continue
        got = Fraction(vals[0], vals[1]) if len(vals) == 2 else Fraction(vals[0])
        if got != want * scale:
            out.append(f"{drift} {RP_CONSTANTS_SRC}: {' / '.join(ours)} = {got}, upstream {name} = {want} "
                       f"(constants.rs:{line}) x {scale}")
        if not re.search(rf"constants\.rs:{line}\b", rust[ours[0]][0]):
            out.append(f"{drift} {RP_CONSTANTS_SRC}: {ours[0]}'s doc does not cite constants.rs:{line}")


