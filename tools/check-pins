    check_nv_writes(root, out)
    check_audit_call(root, out)
    check_release_seq(root, out)
    check_audit_map(root, out)
    check_secret_derives(root, out)
    check_secret_copies(root, out)
    check_cookie_compares(root, out)
    check_verus_trusted(root, out)
    check_cmr_gone(root, out)
    check_mce_unsafe(root, out)
    check_client_requests(root, out)
    check_mce_deps(root, out)
    check_hybrid_constructors(root, out)
    check_classical_groups(root, out)
    check_exchange_callers(root, out)
    check_pass_due(root, out)
    check_cap_barrier(root, out)
    check_old_name(root, out)
    check_firmware(root, out)
    check_no_rndr(root, out)
    check_boot_stage(root, out)
    check_rp_vectors(root, out)
