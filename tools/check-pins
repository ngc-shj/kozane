# P41: D6's canonical unit subset, on the units the operations docs carry.
def unit_problem(lines: list) -> str:
    """Why `lines` (a unit file) is outside the subset, or ''."""
    sections, current = {}, None
    for n, line in enumerate(lines, 1):
        if not line or line.startswith("#"):
            continue
        if line != line.strip() or line.endswith("\\"):
            return f"line {n}: not canonical"
        if line.startswith("[") and line.endswith("]"):
            if line[1:-1] in sections:
                return f"line {n}: section {line} repeated"
            current = sections.setdefault(line[1:-1], set())
            continue
        key, eq, value = line.partition("=")
        if not eq or not key.isalnum() or not key.isascii() or value != value.strip():
            return f"line {n}: want Key=Value"
        if "~" in value:
            return f"line {n}: a `~` (inverted list)"
        if current is None:
            return f"line {n}: outside a section"
        if key in current:
            return f"line {n}: {key} repeated"
        current.add(key)
    return ""


def check_units(root: pathlib.Path, out: list):
    for doc in sorted((root / "docs/operations").glob("*.md")):
        rel = doc.relative_to(root).as_posix()
        lines = doc.read_text().splitlines()
        fences = [i for i, line in enumerate(lines) if line.startswith("```")]
        for start, end in zip(fences[::2], fences[1::2]):
            block = lines[start + 1:end]
            if next((line for line in block if line.strip()), "") != "[Unit]":
                continue
            if (why := unit_problem(block)):
                out.append(f"P41 units: non-canonical unit file: {rel}:{start + 2}: {why}")


# P42: the client's scrub after each initiator call.
CLIENT_LIB = "client/crates/client/src/lib.rs"
CLIENT_INITIATOR_CALLS = 6
INITIATOR_CALL = re.compile(r"\bini\.(start|handle_resp_hello|handle_empty_data|handle_cookie_reply|tick)\(")


# ... and the shells' scrub after each client call (code review S5, TN3):
# kzc's `step` sites and the FFI's two client calls.
CLIENT_NET = "client/crates/client-cli/src/net.rs"
CLIENT_NET_STEPS = 3
CLIENT_FFI = "client/crates/client-ffi/src/lib.rs"
CLIENT_FFI_CALLS = 2
SHELL_SCRUB = "kozane_client::scrub_stack();"


def check_shell_scrub(root: pathlib.Path, out: list):
    texts = {}
    for rel in (CLIENT_NET, CLIENT_FFI):
        try:
            texts[rel] = (root / rel).read_text().splitlines()
        except (OSError, UnicodeDecodeError) as e:
            out.append(f"P42 {rel}: cannot read ({e})")
    if CLIENT_NET in texts:
        lines, steps = texts[CLIENT_NET], 0
        for n, line in enumerate(lines, 1):
            if not re.search(r"\bstep\(\|\|", line):
                continue
            steps += 1
            rest = [l.strip() for l in lines[n:] if l.strip()]
            if not re.match(r"\s*let \w+ = step\(\|\| .*\);$", line) or rest[:1] != [SHELL_SCRUB]:
                out.append(f"P42 {CLIENT_NET}:{n}: a step not followed by {SHELL_SCRUB} (code review S5)")
        if steps != CLIENT_NET_STEPS:
            out.append(f"P42 {CLIENT_NET}: {steps} step calls, want {CLIENT_NET_STEPS}, each followed by {SHELL_SCRUB}")
    # The scrub reaches a call's copies only because the call runs in a frame
    # of its own (code review round 3): each helper stays out of line.
    for rel, fn in ((CLIENT_NET, "fn step("), (CLIENT_FFI, "unsafe fn with_handle(")):
        if rel not in texts:
            continue
        lines = texts[rel]
        at = [n for n, l in enumerate(lines) if l.startswith(fn)]
        if len(at) != 1:
            out.append(f"P42 {rel}: {len(at)} definitions of `{fn}`, want 1")
        elif at[0] == 0 or lines[at[0] - 1].strip() != "#[inline(never)]":
            out.append(f"P42 {rel}:{at[0] + 1}: `{fn}` without #[inline(never)] right above it (code review S7)")
    if CLIENT_FFI in texts:
        lines = [l.strip() for l in texts[CLIENT_FFI]]
        scrubs = [n for n, l in enumerate(lines) if l == SHELL_SCRUB and lines[n + 1:n + 2] == ["code"]]
        if len(scrubs) != CLIENT_FFI_CALLS:
            out.append(f"P42 {CLIENT_FFI}: {len(scrubs)} client calls followed by {SHELL_SCRUB}, "
                       f"want {CLIENT_FFI_CALLS} (code review S5)")


def check_client_scrub(root: pathlib.Path, out: list):
    check_shell_scrub(root, out)
    try:
        lines = (root / CLIENT_LIB).read_text().splitlines()
    except (OSError, UnicodeDecodeError) as e:
        out.append(f"P42 {CLIENT_LIB}: cannot read ({e})")
        return
    calls = 0
    for n, line in enumerate(lines, 1):
        if not INITIATOR_CALL.search(line):
            continue
        calls += 1
        rest = [l.strip() for l in lines[n:] if l.strip()]
        if not re.match(r"\s*let \w+ = ini\.\w+\(.*\);$", line) or rest[:1] != ["scrub_stack();"]:
            out.append(f"P42 {CLIENT_LIB}:{n}: initiator call not followed by scrub_stack() (deviation D-16)")
    if calls != CLIENT_INITIATOR_CALLS:
        out.append(f"P42 {CLIENT_LIB}: {calls} initiator calls, want {CLIENT_INITIATOR_CALLS}; "
                   "each must be followed by scrub_stack()")
    for p in tree_files(root / "client", ("build", ".git", "target")) if (root / "client").is_dir() else []:
        rel = p.relative_to(root).as_posix()
        if p.suffix != ".rs" or rel == CLIENT_LIB or "src" not in p.relative_to(root).parts:
            continue
        for n, line in enumerate(p.read_text().splitlines(), 1):
            if re.search(r"\bInitiator\b", line):
                out.append(f"P42 {rel}:{n}: names Initiator; only {CLIENT_LIB} calls it, with its scrub")


