# P36: I14.1, against the stock machine's device tree.
DTB = "kozane-virt.dtb"


def fdt_nodes(data: bytes) -> list:
    """(path, properties, parent's properties) of every node of a
    flattened device tree, parents before children."""
    import struct
    magic, _, off_struct, off_strings = struct.unpack_from(">4I", data)
    if magic != 0xD00DFEED:
        raise ValueError("not a flattened device tree")

    def string(off: int) -> str:
        start = off_strings + off
        return data[start:data.index(b"\0", start)].decode()

    nodes, stack, p = [], [], off_struct
    while True:
        tok, = struct.unpack_from(">I", data, p)
        p += 4
        if tok == 1:
            end = data.index(b"\0", p)
            name = data[p:end].decode()
            p = (end + 4) & ~3
            props = {}
            stack.append((name, props))
            nodes.append(("/".join(n for n, _ in stack) or "/", props, stack[-2][1] if len(stack) > 1 else None))
        elif tok == 3:
            length, nameoff = struct.unpack_from(">II", data, p)
            p += 8
            stack[-1][1][string(nameoff)] = data[p:p + length]
            p = (p + length + 3) & ~3
        elif tok == 2:
            stack.pop()
        elif tok == 4:
            continue
        elif tok == 9:
            return nodes
        else:
            raise ValueError(f"bad token {tok:#x} at {p - 4}")


def cells(raw: bytes, *widths) -> list:
    """`raw` split into tuples of big-endian numbers of `widths` cells."""
    step = sum(widths) * 4
    if not step or len(raw) % step:
        return []
    out = []
    for at in range(0, len(raw), step):
        row, off = [], at
        for w in widths:
            row.append(int.from_bytes(raw[off:off + 4 * w], "big"))
            off += 4 * w
        out.append(tuple(row))
    return out


def dtb_windows(nodes: list) -> list:
    """(start, end, node) of every root-level device region: a `reg` of a
    child of the root, or a root-level simple-bus's `ranges` window. Memory
    is not a device."""
    root = nodes[0][1]
    acells = int.from_bytes(root.get("#address-cells", b"\0\0\0\2"), "big")
    scells = int.from_bytes(root.get("#size-cells", b"\0\0\0\1"), "big")
    out = []
    for path, props, parent in nodes[1:]:
        if parent is not root or props.get("device_type") == b"memory\0":
            continue
        for base, size in cells(props.get("reg", b""), acells, scells):
            out.append((base, base + size, path))
        if b"simple-bus" in props.get("compatible", b"").split(b"\0"):
            child = int.from_bytes(props.get("#address-cells", b"\0\0\0\1"), "big")
            csize = int.from_bytes(props.get("#size-cells", b"\0\0\0\1"), "big")
            for _, base, size in cells(props.get("ranges", b""), child, acells, csize):
                out.append((base, base + size, path))
    return out


def number(text: str) -> int:
    return int(text.replace("_", ""), 0)


def check_dtb_devices(root: pathlib.Path, sdk, out: list):
    dtb = pathlib.Path(sdk or "") / DTB
    try:
        nodes = fdt_nodes(dtb.read_bytes())
    except (OSError, ValueError, IndexError) as e:
        out.append(f"P36 pins: device not in virt-9.0: cannot read {dtb} ({e})")
        return
    patched = [path for path, props, _ in nodes if b"arm,sp804" in props.get("compatible", b"").split(b"\0")]
    if patched:
        out.append(f"P36 pins: dtb is not stock virt-9.0: {dtb} has arm,sp804 at {', '.join(patched)}")
        return
    windows = dtb_windows(nodes)
    for system in sorted((root / "system").glob("*.system")):
        rel = system.relative_to(root)
        for m in re.finditer(r'<memory_region\b[^>]*>', system.read_text()):
            name = re.search(r'\bname="([^"]*)"', m.group(0))
            addr = re.search(r'\bphys_addr="([^"]*)"', m.group(0))
            if not addr:
                continue
            try:
                at = number(addr.group(1))
            except ValueError:
                out.append(f"P36 pins: device not in virt-9.0: {rel}: phys_addr {addr.group(1)!r} is no number")
                continue
            if not any(start <= at < end for start, end, _ in windows):
                out.append(f"P36 pins: device not in virt-9.0: {rel} mr '{name.group(1) if name else '?'}' "
                           f"phys_addr {at:#x} lies in no device node of {DTB}")


# P37: C1's forbidden patterns, outside the adjudicator.
C1_PATTERNS = re.compile(r'"-bios"|secure=on|mon:stdio')
