# kzc-psk: owns the client's WireGuard interface and holds wg.sk (M9 plan
# D6). Canonical subset: one line per directive, no "~", no repeats.
[Unit]
Description=Kozane client WireGuard interface and PSK helper
After=network-online.target
Wants=network-online.target
Upholds=kozane-net.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/kzc-psk
ExecStopPost=/usr/bin/kzc-psk cleanup
User=kozane-psk
Group=kozane-net
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
LimitCORE=0
LimitMEMLOCK=8M
StateDirectory=kozane-psk
StateDirectoryMode=0700
RuntimeDirectory=kozane-psk
RuntimeDirectoryMode=0750
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
Restart=on-failure

[Install]
WantedBy=multi-user.target
