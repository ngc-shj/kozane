--- a/src/tpm2_fifo_mmio.c
+++ b/src/tpm2_fifo_mmio.c
@@ -0,0 +1,69 @@
+/*
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * FIFO register access over MMIO (TCG PC Client PTP, FIFO interface): the
+ * same register offsets the SPI backend sends in its transaction header,
+ * read and written directly. Accesses are byte-wide except the 1/2/4-byte
+ * chunk reads the FIFO core asks for, which are done at their own width.
+ */
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <tpm2.h>
+#include <tpm2_private.h>
+#include <transport/mmio.h>
+
+/* tpm_interface_init() stores its transport here; unused over MMIO. */
+const struct tpm_spi_plat *tpm_spidev;
+
+static uintptr_t tpm_mmio_base;
+
+void tpm2_fifo_mmio_set_base(uintptr_t base)
+{
+	tpm_mmio_base = base;
+}
+
+static volatile uint8_t *reg8(uint16_t tpm_reg)
+{
+	return (volatile uint8_t *)(tpm_mmio_base + tpm_reg);
+}
+
+int tpm2_fifo_write_byte(uint16_t tpm_reg, uint8_t val)
+{
+	if (tpm_mmio_base == 0U) {
+		return TPM_ERR_TRANSFER;
+	}
+	*reg8(tpm_reg) = val;
+	return TPM_SUCCESS;
+}
+
+int tpm2_fifo_read_byte(uint16_t tpm_reg, uint8_t *val)
+{
+	if (tpm_mmio_base == 0U) {
+		return TPM_ERR_TRANSFER;
+	}
+	*val = *reg8(tpm_reg);
+	return TPM_SUCCESS;
+}
+
+int tpm2_fifo_read_chunk(uint16_t tpm_reg, uint8_t len, void *val)
+{
+	if (tpm_mmio_base == 0U) {
+		return TPM_ERR_TRANSFER;
+	}
+	switch (len) {
+	case 1:
+		*(uint8_t *)val = *reg8(tpm_reg);
+		break;
+	case 2:
+		*(uint16_t *)val = *(volatile uint16_t *)(tpm_mmio_base + tpm_reg);
+		break;
+	case 4:
+		*(uint32_t *)val = *(volatile uint32_t *)(tpm_mmio_base + tpm_reg);
+		break;
+	default:
+		return TPM_INVALID_PARAM;
+	}
+	return TPM_SUCCESS;
+}
--- a/include/transport/mmio.h
+++ b/include/transport/mmio.h
@@ -0,0 +1,17 @@
+/*
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#ifndef TPM_MMIO_H
+#define TPM_MMIO_H
+
+#include <stdint.h>
+
+/*
+ * The FIFO_MMIO interface: the TCG PC Client PTP FIFO register file mapped
+ * at a fixed physical address (QEMU's tpm-tis-device). Set the base before
+ * tpm_interface_init(), which is then passed a NULL transport.
+ */
+void tpm2_fifo_mmio_set_base(uintptr_t base);
+
+#endif /* TPM_MMIO_H */
