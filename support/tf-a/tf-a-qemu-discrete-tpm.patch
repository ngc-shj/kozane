--- a/plat/qemu/qemu/qemu_dtpm.c
+++ b/plat/qemu/qemu/qemu_dtpm.c
@@ -0,0 +1,89 @@
+/*
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Kozane M7 C3: QEMU virt's tpm-tis-device driven from BL1 and BL2.
+ */
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <arch_helpers.h>
+#include <common/debug.h>
+#include <lib/mmio.h>
+#include <platform_def.h>
+
+#include <tpm2.h>
+#include <tpm2_chip.h>
+#include <transport/mmio.h>
+
+#include "qemu_dtpm.h"
+
+#define TPM_ALG_ID_SHA256	0x000BU
+#define TPM_PCR_0		0U
+
+/* PL061: data register at the pin's address mask, direction at 0x400. */
+#define PL061_GPIODIR		0x400U
+#define PL061_DATA(pin)		(1U << ((pin) + 2U))
+
+extern struct tpm_chip_data tpm_chip_data;
+
+/* The FIFO core's timeouts, on the generic counter (no delay timer here). */
+static uint64_t dtpm_timeout_init_us(uint32_t usec)
+{
+	uint64_t freq = read_cntfrq_el0();
+
+	return read_cntpct_el0() + (freq / 1000000U) * usec;
+}
+
+static bool dtpm_timeout_elapsed(uint64_t cnt)
+{
+	return read_cntpct_el0() >= cnt;
+}
+
+void __dead2 qemu_dtpm_fail(const char *stage, const char *step)
+{
+	ERROR("KOZANE-MBOOT: %s %s failed\n", stage, step);
+	console_flush();
+	mmio_write_32(SECURE_GPIO_BASE + PL061_GPIODIR,
+		      mmio_read_32(SECURE_GPIO_BASE + PL061_GPIODIR) |
+			      (1U << SECURE_GPIO_POWEROFF));
+	mmio_write_32(SECURE_GPIO_BASE + PL061_DATA(SECURE_GPIO_POWEROFF),
+		      0xffU);
+	for (;;) {
+		wfi();
+	}
+}
+
+void qemu_dtpm_open(const char *stage, int startup)
+{
+	const struct tpm_timeout_ops timeout_ops = {
+		.timeout_init_us = dtpm_timeout_init_us,
+		.timeout_elapsed = dtpm_timeout_elapsed,
+	};
+
+	tpm2_fifo_mmio_set_base(QEMU_TPM_TIS_BASE);
+	if (tpm_interface_init(NULL, &timeout_ops, &tpm_chip_data, 0) != 0) {
+		qemu_dtpm_fail(stage, "init");
+	}
+	/* Anything but TPM_RC_SUCCESS, TPM_RC_INITIALIZE included, stops. */
+	if ((startup != 0) && (tpm_startup(&tpm_chip_data, TPM_SU_CLEAR) != 0)) {
+		qemu_dtpm_fail(stage, "startup");
+	}
+}
+
+void qemu_dtpm_extend_pcr0(const char *stage, const uint8_t *digest,
+			   size_t digest_len)
+{
+	if ((digest_len != 32U) ||
+	    (tpm_pcr_extend(&tpm_chip_data, TPM_PCR_0, TPM_ALG_ID_SHA256,
+			    digest, (uint32_t)digest_len) != 0)) {
+		qemu_dtpm_fail(stage, "extend");
+	}
+}
+
+void qemu_dtpm_close(const char *stage)
+{
+	if (tpm_interface_close(&tpm_chip_data, 0) != 0) {
+		qemu_dtpm_fail(stage, "close");
+	}
+}
--- a/plat/qemu/qemu/qemu_dtpm.h
+++ b/plat/qemu/qemu/qemu_dtpm.h
@@ -0,0 +1,30 @@
+/*
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Kozane M7 C3: QEMU virt's tpm-tis-device driven from BL1 and BL2, so that
+ * every FIP entry is extended into PCR 0 before it is used.
+ */
+
+#ifndef QEMU_DTPM_H
+#define QEMU_DTPM_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+/* Opens locality 0 (and, in BL1, sends TPM2_Startup(CLEAR)). */
+void qemu_dtpm_open(const char *stage, int startup);
+
+/* Extends PCR 0 with one sha256 digest; stops the boot on any error. */
+void qemu_dtpm_extend_pcr0(const char *stage, const uint8_t *digest,
+			   size_t digest_len);
+
+/* Releases locality 0 for the next stage. */
+void qemu_dtpm_close(const char *stage);
+
+/*
+ * The I3.2 stop: one fixed line naming the stage and the failed step, then
+ * power off through the secure GPIO (QMP SHUTDOWN guest-shutdown).
+ */
+void __dead2 qemu_dtpm_fail(const char *stage, const char *step);
+
+#endif /* QEMU_DTPM_H */
