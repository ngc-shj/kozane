# U-Boot config fragment over qemu_arm64_defconfig (M5 plan C8). The boot
# command is generated from boot.cmd by tools/uboot-config.
CONFIG_CMD_HASH=y
CONFIG_SHA256=y
CONFIG_TPM=y
CONFIG_TPM_V2=y
CONFIG_TPM2_MMIO=y
CONFIG_CMD_TPM=y
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_POWEROFF=y
# dcache/icache before `go`: the Microkit loader expects caches off.
CONFIG_CMD_CACHE=y
CONFIG_USE_BOOTCOMMAND=y
# Boot at once and never stop for a key: the console is not an input.
CONFIG_BOOTDELAY=-2
# With AUTOBOOT_KEYED, autoboot turns Ctrl-C checking off around the boot
# command: otherwise one 0x03 on the UART ends any hush loop, the refusal's
# backstop included (S-BOOT-5). With BOOTDELAY=-2 no key prompt appears.
CONFIG_AUTOBOOT_KEYED=y
# CONFIG_AUTOBOOT_KEYED_CTRLC is not set
# The environment is the compiled-in default only: an environment read from
# storage could replace the boot command (VE6 assumes it cannot).
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_FLASH is not set
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_ENV_IS_IN_EXT4 is not set
# CONFIG_ENV_IS_IN_UBI is not set
# CONFIG_ENV_IS_IN_SPI_FLASH is not set
# The version string must not depend on the git state of whatever tree the
# tarball is unpacked in (setlocalversion reads it): the same sources build
# the same firmware whether the tree is clean, dirty or a selftest copy.
# CONFIG_LOCALVERSION_AUTO is not set
# Host tools without OpenSSL (the image has no headers); kwbimage selects it.
# CONFIG_TOOLS_KWBIMAGE is not set
# CONFIG_TOOLS_LIBCRYPTO is not set
# CONFIG_TOOLS_MKEFICAPSULE is not set
# CONFIG_TOOLS_MKFWUMDATA is not set
